# BNS Enerji & Doğalgaz — WordPress geçiş redirect'leri
# Domain 6 ay WP'deydi, Mayıs 2026'da Astro'ya geçti.
# 301: kalıcı taşınma — Google SEO equity yeni URL'e aktarır.
# 410: gone — eski WP teknik URL'leri için, 404'ten hızlı index dışı.

# Hizmet sayfası varyantları → /hizmetler/
/services            /hizmetler/         301
/services/           /hizmetler/         301
/service             /hizmetler/         301
/service/            /hizmetler/         301
/hizmetlerimiz       /hizmetler/         301
/hizmetlerimiz/      /hizmetler/         301
/servisler           /hizmetler/         301
/servisler/          /hizmetler/         301

# Hakkımızda varyantları → /hakkimizda/
/about               /hakkimizda/        301
/about/              /hakkimizda/        301
/about-us            /hakkimizda/        301
/about-us/           /hakkimizda/        301
/hakkinda            /hakkimizda/        301
/hakkinda/           /hakkimizda/        301

# İletişim varyantları → /iletisim/
/contact             /iletisim/          301
/contact/            /iletisim/          301
/contact-us          /iletisim/          301
/contact-us/         /iletisim/          301
/bize-ulasin         /iletisim/          301
/bize-ulasin/        /iletisim/          301

# Referanslar varyantları → /referanslar/
/references          /referanslar/       301
/references/         /referanslar/       301
/portfolio           /referanslar/       301
/portfolio/          /referanslar/       301

# Ürünler varyantları → /urunler/
/products            /urunler/           301
/products/           /urunler/           301
/urunlerimiz         /urunler/           301
/urunlerimiz/        /urunler/           301

# WP varsayılan demo sayfalar → /
/sample-page         /                   301
/sample-page/        /                   301
/hello-world         /                   301
/hello-world/        /                   301

# Category / tag / author / date arşivleri → /
/category/*          /                   301
/tag/*               /                   301
/author/*            /                   301
/date/*              /                   301
/archive/*           /                   301

# WooCommerce mağaza / ürün arşivleri → /urunler/ ("KOMBİ arşivleri" junk dahil)
/shop                /urunler/           301
/shop/               /urunler/           301
/magaza              /urunler/           301
/magaza/             /urunler/           301
/product-category/*  /urunler/           301
/urun-kategorisi/*   /urunler/           301
/product/*           /urunler/           301
/urun/*              /urunler/           301
/cart/               /urunler/           301
/sepet/              /urunler/           301
/checkout/           /urunler/           301
/my-account/         /                   301

# WP yönetim/içerik prefix'leri (/wp-admin/*, /wp-content/*, /wp-includes/*,
# /wp-json/*, /xmlrpc.php) için redirect TANIMLANMADI — Cloudflare Workers
# Static Assets convention sadece 200/301/302/303/307/308 kabul ediyor (410
# yok). Bu path'ler default Worker 404 davranışıyla Astro custom 404.astro'ya
# düşer (noindex meta + hizmet liste linkleri). Google "kaldırıldı" sinyalini
# 404'ten alır — 410'la aynı sonuç, sadece biraz daha yavaş düşürme.
