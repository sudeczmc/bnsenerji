              </a>
            </div>
          </div>

          <!-- Hizmetler -->
          <div class="footer-col">
            <h3>Hizmetler</h3>
            <ul>
              {hizmetler.map((h) => (
                <li><a href={`/hizmetler/${h.slug}/`}>{h.kisaAd}</a></li>
