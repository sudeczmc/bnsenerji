---
import "../styles/global.css";
import { hizmetler } from "../data/hizmetler";

interface BreadcrumbItem { name: string; href: string; }

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  modifiedDate?: string;
  publishDate?: string;
  extraSchemas?: object[];
  mainEntityId?: string;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  modifiedDate,
  publishDate,
  extraSchemas = [],
  mainEntityId,
  breadcrumbs,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const buildDate = new Date().toISOString();
const yil = new Date().getFullYear();

// Klima sezonu (Mayıs–Eylül) → WhatsApp prefilled metnini klima keşfine yönlendirir
const ayLayout = new Date().getMonth() + 1;
const klimaSezonu = ayLayout >= 5 && ayLayout <= 9;
const waText = klimaSezonu
  ? "Merhaba BNS Enerji, klima keşif randevusu almak istiyorum."
  : "Merhaba BNS Enerji, bilgi almak istiyorum.";
const waHref = `https://wa.me/905324993986?text=${encodeURIComponent(waText)}`;

/* ── BREADCRUMBS ── */
const finalBreadcrumbs: BreadcrumbItem[] =
  breadcrumbs ?? (Astro.url.pathname === "/"
    ? []
    : [{ name: "Anasayfa", href: "/" }, { name: title.split(" — ")[0] ?? title, href: Astro.url.pathname }]);

const breadcrumbSchema = finalBreadcrumbs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": canonicalURL.href + "#breadcrumb",
      itemListElement: finalBreadcrumbs.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.name,
        item: new URL(item.href, Astro.site).href,
      })),
    }
  : null;

/* ── SCHEMA: WebSite ── */
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://bnsenerjidogalgaz.com/#website",
  name: "BNS Enerji & Doğalgaz",
  alternateName: "Polatlı Doğalgaz BNS",
  url: "https://bnsenerjidogalgaz.com",
  publisher: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
  inLanguage: "tr-TR",
};

/* ── SCHEMA: WebPage ── */
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonicalURL.href + "#webpage",
  url: canonicalURL.href,
  name: title,
  description: description,
  inLanguage: "tr-TR",
  isPartOf: { "@id": "https://bnsenerjidogalgaz.com/#website" },
  about: { "@id": "https://bnsenerjidogalgaz.com/#business" },
  dateModified: modifiedDate ?? buildDate,
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [
      "h1",
      ".page-title",
      ".hero-title",
      ".hd-tldr p",
      ".page-intro",
      "meta[name='description']",
    ],
  },
  ...(publishDate && { datePublished: publishDate }),
  ...(breadcrumbSchema && { breadcrumb: { "@id": canonicalURL.href + "#breadcrumb" } }),
  ...(mainEntityId && { mainEntity: { "@id": mainEntityId } }),
};

/* ── SCHEMA: Organization ── */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://bnsenerjidogalgaz.com/#organization",
  name: "BNS Enerji & Doğalgaz",
  alternateName: ["BNS Enerji", "BNS Doğalgaz", "Polatlı BNS Enerji", "BNS Enerji Doğal Gaz"],
  legalName: "BNS Enerji Doğal Gaz Tesisat Taahhüt Mühendislik Tarım Turizm İnşaat Emlak Sanayi ve Ticaret Limited Şirketi",
  description: "Polatlı/Ankara merkezli doğalgaz ve tesisat firması. Doğalgaz tesisatı, klima, ısı pompası, yangın söndürme, yerden ısıtma ve merkezi ısıtma sistemleri.",
  url: "https://bnsenerjidogalgaz.com",
  logo: {
    "@type": "ImageObject",
    "@id": "https://bnsenerjidogalgaz.com/#logo",
    url: "https://bnsenerjidogalgaz.com/images/wp/cropped-cropped-cropped-IMG_9920-2-1.jpg",
    contentUrl: "https://bnsenerjidogalgaz.com/images/wp/cropped-cropped-cropped-IMG_9920-2-1.jpg",
    caption: "BNS Enerji & Doğalgaz logosu",
    creator: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
    copyrightHolder: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
    creditText: "BNS Enerji & Doğalgaz",
    license: "https://bnsenerjidogalgaz.com/kalite-politikasi/",
    acquireLicensePage: "https://bnsenerjidogalgaz.com/iletisim/",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+905324993986",
    contactType: "customer service",
    areaServed: "TR",
    availableLanguage: ["Turkish"],
  },
  sameAs: [
    "https://www.instagram.com/bnsenerjidogalgaz/",
    "https://www.linkedin.com/company/bns-enerji%CC%87-%26-do%C4%9Falgaz/",
  ],
};

/* ── SCHEMA: LocalBusiness ── */
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://bnsenerjidogalgaz.com/#business",
  name: "BNS Enerji & Doğalgaz",
  alternateName: ["BNS Enerji", "BNS Doğalgaz", "Polatlı BNS Enerji"],
  description: "Polatlı/Ankara merkezli doğalgaz tesisat, klima, ısı pompası, yangın söndürme, yerden ısıtma ve merkezi ısıtma hizmeti.",
  url: "https://bnsenerjidogalgaz.com",
  telephone: "+905324993986",
  email: "bnsenerji@gmail.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fatih Mah., Bıyıktay Cd. 37/A",
    addressLocality: "Polatlı",
    addressRegion: "Ankara",
    postalCode: "06900",
    addressCountry: "TR",
  },
  geo: { "@type": "GeoCoordinates", latitude: 39.5840, longitude: 32.1469 },
  areaServed: [
    { "@type": "City", name: "Polatlı", containedInPlace: { "@type": "AdministrativeArea", name: "Ankara" } },
    { "@type": "AdministrativeArea", name: "Ankara" },
    // Polatlı yoğun mahalleler — hyperlocal SEO (mahalle bazlı arama için)
    { "@type": "Place", name: "Fatih Mahallesi, Polatlı" },
    { "@type": "Place", name: "Yenimahalle, Polatlı" },
    { "@type": "Place", name: "Karşıyaka Mahallesi, Polatlı" },
    { "@type": "Place", name: "Cumhuriyet Mahallesi, Polatlı" },
    { "@type": "Place", name: "Şentepe Mahallesi, Polatlı" },
    { "@type": "Place", name: "Yıldız Mahallesi, Polatlı" },
    { "@type": "Place", name: "Atatürk Mahallesi, Polatlı" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    opens: "08:00",
    closes: "20:00",
  },
  priceRange: "₺₺",
  image: {
    "@type": "ImageObject",
    "@id": "https://bnsenerjidogalgaz.com/#primary-image",
    url: "https://bnsenerjidogalgaz.com/og-image.png",
    contentUrl: "https://bnsenerjidogalgaz.com/og-image.png",
    caption: "BNS Enerji & Doğalgaz — Polatlı doğalgaz, klima ve ısı pompası firması",
    creator: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
    copyrightHolder: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
    creditText: "BNS Enerji & Doğalgaz",
    license: "https://bnsenerjidogalgaz.com/kalite-politikasi/",
    acquireLicensePage: "https://bnsenerjidogalgaz.com/iletisim/",
  },
  isicV4: "4322",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Enerji ve Tesisat Hizmetleri",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Doğalgaz Tesisatı ve Projelendirme" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Isı Pompası Montajı" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Yangın Söndürme Sistemleri" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Klima Sistemleri" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Yerden Isıtma Sistemleri" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Merkezi Isıtma ve Kazan Sistemleri" } },
    ],
  },
};

const allSchemas = [
  websiteSchema,
  webPageSchema,
  organizationSchema,
  localBusinessSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...extraSchemas,
];

const currentPath = Astro.url.pathname;

/* ── NAVİGASYON ── */
const hizmetAlt = hizmetler.map((h) => ({ href: `/hizmetler/${h.slug}/`, label: h.kisaAd }));
const nav = [
  { href: "/", label: "Anasayfa" },
  { href: "/hizmetler/", label: "Hizmetler", dropdown: hizmetAlt },
  { href: "/urunler/", label: "Ürünler" },
  { href: "/referanslar/", label: "Referanslar" },
  { href: "/hakkimizda/", label: "Hakkımızda" },
  { href: "/iletisim/", label: "İletişim" },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6B9F35" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="author" content="BNS Enerji & Doğalgaz" />
    <meta name="geo.region" content="TR-06" />
    <meta name="geo.placename" content="Polatlı, Ankara" />
    <meta name="geo.position" content="39.5840;32.1469" />
    <meta name="ICBM" content="39.5840, 32.1469" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="BNS Enerji & Doğalgaz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Favicon set -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- JSON-LD schema graph -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="search" type="application/opensearchdescription+xml"
          href="/opensearch.xml" title="BNS Enerji ara" />

    <!-- Speculation Rules API (Chrome 121+) — sonraki sayfayı arka planda prerender
         hover/touch'da, 0ms perceived navigation. NavBoost dwell + return visit boost. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prerender: [{
        where: { and: [
          { href_matches: "/*" },
          { not: { href_matches: "/iletisim/*" } },
          { not: { selector_matches: "[rel~=nofollow]" } },
          { not: { selector_matches: ".no-prerender" } }
        ]},
        eagerness: "moderate"
      }],
      prefetch: [{
        where: { href_matches: "/*" },
        eagerness: "moderate"
      }]
    })} />
  </head>

  <body>
    <a href="#main-content" class="skip-link">İçeriğe atla</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-logo" aria-label="BNS Enerji & Doğalgaz - Anasayfa">
          <img
            src="/images/bns-logo.png"
            alt="BNS ENERJİ & DOĞALGAZ"
            width="684"
            height="503"
            decoding="async"
          />
        </a>

        <nav aria-label="Ana navigasyon" class="main-nav" id="main-nav">
          {nav.map((item) => (
            item.dropdown ? (
              <div class="nav-item has-dropdown">
                <a
                  href={item.href}
                  class:list={["nav-link", { active: currentPath.startsWith("/hizmetler") }]}
                >
                  {item.label}
                  <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="13" height="13" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </a>
                <div class="dropdown">
                  {item.dropdown.map((d) => (
                    <a href={d.href} class="dropdown-link">{d.label}</a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={["nav-link", { active: currentPath === item.href }]}
              >
                {item.label}
              </a>
            )
          ))}
        </nav>

        <a href="tel:+905324993986" class="header-cta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>0 532 499 39 86</span>
        </a>

        <button class="nav-toggle" id="nav-toggle" aria-label="Menü" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="main-content"><slot /></main>

    <a
      href={waHref}
      class="whatsapp-float"
      target="_blank"
      rel="noopener"
      aria-label="WhatsApp ile yazın"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
    </a>

    <footer class="site-footer">
