          <!-- Kurumsal -->
          <div class="footer-col">
            <h3>Kurumsal</h3>
            <ul>
              <li><a href="/hakkimizda/">Hakkımızda</a></li>
              <li><a href="/referanslar/">Referanslar</a></li>
              <li><a href="/urunler/">Ürünler</a></li>
              <li><a href="/kalite-politikasi/">Kalite Politikası</a></li>
