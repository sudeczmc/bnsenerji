                <a href="mailto:bnsenerji@gmail.com">bnsenerji@gmail.com</a>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                <span>Pazartesi – Cumartesi, 08:00 – 20:00</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <p>© 2020 – {yil} BNS Enerji &amp; <span class="lite-green">Doğalgaz</span></p>
          <p class="footer-bottom-loc">Polatlı / Ankara</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('nav-toggle')?.addEventListener('click', function () {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', String(!expanded));
        document.getElementById('main-nav')?.classList.toggle('open');
      });

      // Scroll'da header'a gölge
      (function () {
        var header = document.querySelector('.site-header');
        if (!header) return;
        var onScroll = function () {
          header.classList.toggle('scrolled', window.scrollY > 8);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();

      // Scroll-reveal — çok katmanlı güvenlik (memory dersi: içerik daima görünür)
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('motion-on');
        var sec =
          '.bolum-head, .kart, .surec-adim, .kesit-cizim, .kesit-madde, .kesit-adim, .bosch-urun, .stat, .kesif-blok, .il-harita, .hd-blok, .hd-gorsel, .metin-blok, .kp-quote, .ilke-list, .hd-hero-gorsel';
        var hedefler = document.querySelectorAll(sec);
        var obs = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('gorundu');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
        );
        hedefler.forEach(function (el, i) {
          el.classList.add('reveal');
          el.style.transitionDelay = (i % 4) * 0.06 + 's';
          obs.observe(el);
        });
        // güvenlik ağı — observer bir şeyi kaçırırsa içerik 2.6 sn sonra görünür
        setTimeout(function () {
          document.querySelectorAll('.reveal:not(.gorundu)').forEach(function (el) {
            el.classList.add('gorundu');
          });
        }, 2600);
      })();
    </script>

    <style is:global>
      /* ─── HEADER ─── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: #ffffff;
        border-bottom: 3px solid #6B9F35;
        transition: box-shadow var(--duration-base) var(--ease-bns);
      }
      .site-header.scrolled {
        box-shadow: 0 6px 24px -12px rgba(0, 0, 0, 0.25);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        padding-block: 14px;
      }
      .site-logo {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        margin-right: auto;
      }
      .site-logo img {
        height: 58px;
        width: auto;
      }

      .main-nav {
        display: flex;
        gap: var(--space-6);
        align-items: center;
      }
      .nav-item { position: relative; }
      .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: "Poppins", sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: #292929;
        transition: color var(--duration-base) var(--ease-bns);
      }
      .nav-link:hover,
      .nav-link.active { color: #6B9F35; }
      .nav-chevron {
        transition: transform var(--duration-base) var(--ease-bns);
      }
      .has-dropdown:hover .nav-chevron { transform: rotate(180deg); }

      /* Açılır menü — CSS-only, JS yok */
      .dropdown {
        position: absolute;
        top: calc(100% + 14px);
        left: 50%;
        transform: translateX(-50%) translateY(8px);
        min-width: 248px;
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-lg);
        padding: var(--space-2);
        display: flex;
        flex-direction: column;
        gap: 2px;
        opacity: 0;
        visibility: hidden;
        transition:
          opacity var(--duration-base) var(--ease-bns),
          transform var(--duration-base) var(--ease-bns);
        z-index: 110;
      }
      .has-dropdown::after {
        /* hover boşluğu köprüsü */
        content: "";
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        height: 16px;
      }
      .has-dropdown:hover .dropdown,
      .has-dropdown:focus-within .dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }
      .dropdown-link {
        padding: 11px 14px;
        border-radius: var(--radius-sm);
        font-size: 14px;
        font-weight: 500;
        color: #292929;
        white-space: nowrap;
        transition:
          background-color var(--duration-fast) var(--ease-bns),
          color var(--duration-fast) var(--ease-bns);
      }
      .dropdown-link:hover {
        background: var(--color-primary-bg);
        color: var(--color-primary-deep);
      }

      /* Telefon CTA */
      .header-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        background: var(--color-primary);
        color: #ffffff;
        padding: 11px 18px;
        border-radius: var(--radius-md);
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        font-weight: 600;
        transition:
          background-color var(--duration-base) var(--ease-bns),
          transform var(--duration-fast) var(--ease-bns);
      }
      .header-cta:hover { background: var(--color-primary-hover); }
      .header-cta:active { transform: scale(0.97); }

      .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        padding: 8px;
        flex-shrink: 0;
      }
      .nav-toggle span {
        width: 24px;
        height: 2px;
        background: #292929;
        border-radius: 1px;
        transition: all var(--duration-base) var(--ease-bns);
      }

      @media (max-width: 960px) {
        .header-cta span { display: none; }
        .header-cta { padding: 11px; }
      }
      @media (max-width: 860px) {
        .main-nav {
          position: fixed;
          inset: 0 0 0 auto;
          width: min(82vw, 340px);
          background: #ffffff;
          flex-direction: column;
          align-items: stretch;
          padding: 88px var(--space-6) var(--space-8);
          gap: var(--space-2);
          overflow-y: auto;
          transform: translateX(100%);
          transition: transform var(--duration-base) var(--ease-bns);
          box-shadow: var(--shadow-xl);
        }
        .main-nav.open { transform: translateX(0); }
        .nav-toggle { display: flex; }
        .nav-link { padding-block: 10px; font-size: 16px; }
        /* mobilde açılır menü her zaman açık alt liste */
        .dropdown {
          position: static;
          transform: none;
          opacity: 1;
          visibility: visible;
          min-width: 0;
          border: none;
          box-shadow: none;
          padding: 0 0 var(--space-2) var(--space-4);
          border-left: 2px solid var(--color-border);
          margin-left: var(--space-2);
        }
        .has-dropdown::after { display: none; }
        .nav-chevron { display: none; }
        /* telefon CTA mobilde ikon-only kalır (960px kuralı) — menü simgesi en sağda */
      }

      /* ─── WHATSAPP FLOAT ─── */
      .whatsapp-float {
        position: fixed;
        right: var(--space-5);
        bottom: var(--space-5);
        z-index: 90;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: var(--radius-full);
        background: #25d366;
        color: #ffffff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
        transition: transform var(--duration-base) var(--ease-bns);
      }
      .whatsapp-float:hover { transform: scale(1.08); }

      /* ─── FOOTER ─── */
      .site-footer {
        margin-top: var(--space-24);
        font-family: "Poppins", sans-serif;
      }
      .footer-main {
        background: #1f2420;
        color: #ffffff;
        padding-block: var(--space-16);
      }
      .footer-cols {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1.5fr;
        gap: var(--space-10);
      }

      /* Marka sütunu */
      .footer-logo {
        font-size: 1.05rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: rgba(255, 255, 255, 0.85);
      }
      .footer-logo strong {
        font-weight: 800;
        color: #6B9F35;
      }
      .footer-brand p {
        margin-top: var(--space-4);
        font-size: 0.9rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.6);
        max-width: 30ch;
      }
      .footer-social {
        display: flex;
        gap: var(--space-3);
        margin-top: var(--space-5);
      }
      .footer-social a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: var(--radius-sm);
        background: rgba(255, 255, 255, 0.07);
        color: rgba(255, 255, 255, 0.75);
        transition:
          background-color var(--duration-base) var(--ease-bns),
          color var(--duration-base) var(--ease-bns);
      }
      .footer-social a:hover { background: #6B9F35; color: #ffffff; }

      /* Link sütunları */
      .footer-col h3 {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #6B9F35;
        margin-bottom: var(--space-5);
      }
      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      .footer-col a {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.9rem;
        transition: color var(--duration-base) var(--ease-bns);
      }
      .footer-col a:hover { color: #ffffff; }

      .footer-contact li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.5;
      }
      .footer-contact svg { flex-shrink: 0; color: #6B9F35; margin-top: 1px; }
      .footer-contact a { color: rgba(255, 255, 255, 0.72); }
      .footer-contact a:hover { color: #ffffff; }

      .footer-bottom {
        background: #161917;
        color: rgba(255, 255, 255, 0.55);
        padding-block: 18px;
      }
      .footer-bottom-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-4);
        flex-wrap: wrap;
      }
      .footer-bottom p { font-size: 0.85rem; }
      .footer-bottom-loc { color: rgba(255, 255, 255, 0.4); }
      .lite-green { color: #a5f775; }

      @media (max-width: 860px) {
        .footer-cols { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
        .footer-brand { grid-column: 1 / -1; }
      }
      @media (max-width: 540px) {
        .footer-cols { grid-template-columns: 1fr; }
        .footer-bottom-inner { justify-content: center; }
      }
    </style>
  </body>
</html>
