---
import Layout from "../layouts/Layout.astro";

const hizmetler = [
  {
    baslik: "Gaz Tesisatı",
    metin: "Enerji tasarruflu ve güvenli doğalgaz iç tesisat sistemleri.",
    icon: `<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>`,
  },
  {
    baslik: "Yangın Tesisatı",
    metin: "Profesyonel yangın söndürme ve güvenlik çözümleri.",
    icon: `<path d="M15 6.5V19a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V6.5"/><path d="M9 6.5a3 3 0 0 1 6 0"/><path d="M12 3.6V2M15 5h3a2 2 0 0 1 2 2v2"/><path d="M9 11h6"/>`,
  },
  {
    baslik: "Yerden Isıtma",
    metin: "Konforlu ve dengeli ısı dağılımı sağlayan sistemler.",
    icon: `<path d="M8 2v4M12 2v4M16 2v4M4 10h16M4 14h16M4 18h16"/>`,
  },
];
---

<Layout
  title="BNS Enerji & Doğalgaz Polatlı — Modern ve Yenilenebilir Enerji"
  description="Polatlı'da 2020'den bu yana doğalgaz, yangın ve ısıtma sistemlerinde güvenilir tesisat çözümleri. BNS Enerji & Doğalgaz."
>
  <section class="lp-hero">
    <img class="lp-hero-bg" src="/images/wp/Photo-ecofriendly-concept-of-greenery-gr.jpg" alt="" aria-hidden="true" />
    <div class="lp-hero-overlay"></div>
    <div class="container lp-hero-inner">
      <p class="lp-hero-eyebrow">Modern ve Yenilenebilir Enerji Odaklı</p>
      <h1 class="lp-hero-baslik">BNS Enerji &amp; <mark>Doğalgaz</mark> Polatlı</h1>
      <p class="lp-hero-metin">
        2020'den bu yana doğalgaz, yangın ve ısıtma sistemlerinde güvenilir
        tesisat çözümleri sunuyoruz.
      </p>
      <a class="btn btn-fill" href="/iletisim/">Bizimle iletişime geçin</a>
    </div>
  </section>

  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Hizmetlerimiz</p>
        <h2 class="page-title">Polatlı'da uçtan uca tesisat çözümleri</h2>
      </header>
      <div class="kart-grid g-3">
        {hizmetler.map((h) => (
          <article class="kart">
            <span class="kart-ikon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" set:html={h.icon} />
            </span>
            <h3 class="kart-baslik">{h.baslik}</h3>
            <p class="kart-metin">{h.metin}</p>
          </article>
        ))}
      </div>
      <p class="bolum-not">
        BNS Enerji, 2020'den bu yana Polatlı'da doğalgaz ve tesisat alanında
        çevre dostu çözümler üretiyor.
        <a href="/hakkimizda/">Hakkımızda</a>
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  .lp-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(380px, 52vh, 520px);
    overflow: hidden;
  }
  .lp-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .lp-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(165deg, rgba(20, 35, 12, 0.66) 0%, rgba(10, 20, 6, 0.78) 100%);
  }
  .lp-hero-inner {
    position: relative;
    z-index: 2;
    color: #ffffff;
    padding-block: var(--space-16);
    max-width: 860px;
  }
  .lp-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-soft);
    margin-bottom: var(--space-4);
  }
  .lp-hero-baslik {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-display);
    color: #ffffff;
  }
  .lp-hero-baslik mark { background: transparent; color: var(--color-primary); }
  .lp-hero-metin {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: rgba(255, 255, 255, 0.86);
    max-width: 54ch;
    margin-block: var(--space-5) var(--space-7);
  }
</style>
