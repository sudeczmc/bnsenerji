---
import Layout from "../layouts/Layout.astro";

const ilkeler = [
  "Müşteri taleplerine en uygun teknik çözümleri sunmak",
  "Tesisat kurulumlarını standartlara uygun şekilde gerçekleştirmek",
  "Malzeme ve işçilik kalitesinden ödün vermemek",
  "Sürekli gelişim ve müşteri memnuniyetini esas almak",
];
---

<Layout
  title="Kalite Politikamız — BNS Enerji & Doğalgaz"
  description="BNS Enerji & Doğalgaz kalite politikası: doğru malzeme seçimi, tecrübeli personel, zamanında teslimat ve satış sonrası destek ilkeleriyle uzun ömürlü çözümler."
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <div class="kp-split">
        <div class="kp-metin">
          <header class="section-head">
            <p class="eyebrow">Kalite Politikamız</p>
            <h1 class="page-title">Kalite, yaptığımız her işin temelidir</h1>
          </header>

          <div class="metin-blok">
            <p>
              <strong>BNS Enerji &amp; Doğalgaz</strong> olarak; doğalgaz, ısı
              pompası, yangın söndürme ve sıhhi tesisat sistemlerinde güvenilir,
              kaliteli ve uzun ömürlü çözümler sunmayı ilke edindik. Tüm
              projelerimizde müşteri memnuniyetini, iş güvenliğini ve hizmet
              kalitesini en üst düzeyde tutmayı hedefliyoruz.
            </p>
            <p>
              Kalite anlayışımız; doğru malzeme seçimi, tecrübeli personel,
              zamanında teslimat ve satış sonrası destek prensipleri üzerine
              kuruludur. Her kurulumun uzun yıllar sorunsuz çalışması için
              titizlikle çalışırız.
            </p>
          </div>
        </div>

        <ul class="ilke-list">
          {ilkeler.map((i) => (
            <li>
              <span class="ilke-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </div>

      <blockquote class="kp-quote">
        <p>"Kalite, yaptığımız her işin temelidir; güven ise en büyük
        referansımızdır."</p>
        <cite>BNS Enerji &amp; Doğalgaz</cite>
      </blockquote>
    </div>
  </section>
</Layout>

<style is:global>
  .kp-split {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .metin-blok {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .metin-blok p {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-text-body);
  }
  .metin-blok strong { color: var(--color-text); font-weight: var(--weight-semibold); }

  .ilke-list {
    width: 100%;
    list-style: none;
    padding: 0;
    margin: var(--space-10) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  @media (max-width: 760px) {
    .ilke-list { margin-top: 0; }
  }
  .ilke-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-body);
  }
  .ilke-mark {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #ffffff;
  }

  .kp-quote {
    max-width: 680px;
    margin-top: var(--space-16);
    padding-left: var(--space-8);
    border-left: 3px solid var(--color-primary);
  }
  .kp-quote p {
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-text);
    line-height: var(--leading-snug);
  }
  .kp-quote cite {
    display: block;
    margin-top: var(--space-4);
    font-style: normal;
    font-weight: var(--weight-semibold);
    color: var(--color-primary-deep);
  }

  @media (max-width: 760px) {
    .kp-split { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
