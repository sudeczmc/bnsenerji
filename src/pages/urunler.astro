---
import Layout from "../layouts/Layout.astro";

/* Ürün vitrini: ana başlık ürün kategori (agnostik), alt etiket vitrindeki
   Bosch model (BNS Bosch Partner Program üyesi olduğu için Bosch öne çıkar).
   Müşterinin isteği farklı bir markaysa keşifte birlikte değerlendirilir. */
const urunler = [
  {
    kategori: "Inverter Split Klima",
    vitrinMarka: "Bosch Climate Serisi",
    aciklama:
      "Konut ve iş yerleri için yüksek verimli inverter split klima — yaz serinliği, kış ısısı tek cihazda.",
    gorsel: "/images/bosch-klima-hd.webp",
    urun: true,
    ozellikler: [
      "A++ enerji sınıfı, çevre dostu R-32 soğutucu gaz",
      "Turbo ve uyku modu, kolay sökülüp temizlenen filtre",
      "9.000 / 12.000 / 18.000 / 24.000 / 48.000 BTU kapasite seçenekleri",
    ],
  },
  {
    kategori: "Yoğuşmalı Kombi",
    vitrinMarka: "Bosch Condens",
    aciklama:
      "Tam yoğuşma teknolojisiyle tasarruflu, dengeli ve sessiz ısınma — konut ve daireler için.",
    gorsel: "/images/bosch-kombi-hd.webp",
    urun: true,
    ozellikler: [
      "Tam yoğuşma teknolojisi — yüksek ısıl verim",
      "Paslanmaz çelik ısı eşanjörü ile uzun ömür",
      "Kademesiz modülasyon — anlık ihtiyaca göre kapasite",
      "47 dB altı sessiz çalışma",
    ],
  },
  {
    kategori: "Hava-Su Isı Pompası",
    vitrinMarka: "Bosch Compress",
    aciklama:
      "Hava kaynaklı ısı pompasıyla tek sistemde ısıtma, soğutma ve sıcak kullanım suyu.",
    gorsel: "/images/bosch-isipompasi-hd.webp",
    urun: true,
    ozellikler: [
      "A+++ ErP verimlilik sınıfı, yüksek SCOP değeri",
      "Inverter kompresör — ihtiyaca göre çalışma hızı",
      "Isıtma + soğutma + sıcak su, tek ünitede",
      "8 / 10 / 14 kW kapasite, R-32 soğutucu gaz",
    ],
  },
  {
    kategori: "VRF Klima Sistemi",
    vitrinMarka: "Bosch VRF Climate 5000 L",
    aciklama:
      "Otel, iş merkezi ve büyük binalar için tek dış üniteyle çok bölgeli iklimlendirme.",
    gorsel: "/images/bosch-vrf-hd.webp",
    urun: true,
    ozellikler: [
      "Tek dış üniteyle 4–12 bağımsız bölge kontrolü",
      "Inverter DC kompresör — üst sınıf enerji verimliliği",
      "Otel, hastane, okul ve villa gibi büyük yapılara uygun",
      "Bina yönetim sistemine entegre merkezi kontrol",
    ],
  },
];

/* ── SCHEMA: ItemList + Product (enriched) — Product name kategori (agnostik),
   brand: Bosch (vitrindeki model için doğru), additionalProperty'de vitrin
   notu + diğer marka talebi bilgisi → Knowledge Graph derinliği. ── */
const urunSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "https://bnsenerjidogalgaz.com/urunler/#products",
  name: "BNS Enerji & Doğalgaz — Polatlı Klima, Kombi, Isı Pompası, VRF",
  numberOfItems: urunler.length,
  itemListElement: urunler.map((u, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      "@id": `https://bnsenerjidogalgaz.com/urunler/#product-${i + 1}`,
      name: u.kategori,
      description: u.aciklama,
      image: `https://bnsenerjidogalgaz.com${u.gorsel}`,
      brand: {
        "@type": "Brand",
        name: "Bosch",
        url: "https://www.bosch.com.tr/",
      },
      manufacturer: {
        "@type": "Organization",
        name: "Bosch Thermotechnik",
        url: "https://www.bosch-thermotechnology.com/",
      },
      category: "HVAC / İklimlendirme, Isıtma ve Soğutma Sistemleri",
      additionalProperty: [
        { "@type": "PropertyValue", name: "Vitrin örneği", value: u.vitrinMarka },
        { "@type": "PropertyValue", name: "Marka politikası", value: "Müşterinin isteğine ve bütçesine uygun farklı marka talepleri keşifte birlikte değerlendirilir" },
        ...u.ozellikler.map((o) => ({
          "@type": "PropertyValue",
          value: o,
        })),
      ],
      offers: {
        "@type": "Offer",
        availability: "https://schema.org/InStock",
        priceCurrency: "TRY",
        priceSpecification: {
          "@type": "PriceSpecification",
          priceCurrency: "TRY",
          valueAddedTaxIncluded: true,
        },
        seller: { "@id": "https://bnsenerjidogalgaz.com/#business" },
        areaServed: [
          { "@type": "City", name: "Polatlı" },
          { "@type": "AdministrativeArea", name: "Ankara" },
        ],
        url: "https://bnsenerjidogalgaz.com/iletisim/",
      },
    },
  })),
};
---

<Layout
  title="Polatlı Klima, Kombi, Isı Pompası ve VRF | BNS Enerji"
  description="Polatlı'da klima, yoğuşmalı kombi, ısı pompası ve VRF sistemleri. Vitrinden Bosch örnekleri; müşterinin isteğine ve bütçesine uygun farklı marka talepleri keşifte birlikte değerlendirilir."
  extraSchemas={[urunSchema]}
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Ürünler</p>
        <h1 class="page-title">Klima, kombi, ısı pompası ve VRF</h1>
        <p class="page-intro">
          Müşterinin isteğine ve bütçesine uygun markada klima, yoğuşmalı kombi,
          ısı pompası ve VRF tedarik ediyoruz. Bosch Partner Program üyesi olarak
          vitrinimizdeki öne çıkan Bosch modelleri aşağıda; farklı marka talepleri
          keşifte birlikte değerlendirilir.
        </p>
      </header>

      <div class="urun-grid">
        {urunler.map((u) => (
          <article class="kart kart-gorselli urun-kart">
            <div class:list={["kart-foto", { "kart-foto-urun": u.urun }]}>
              <img src={u.gorsel} alt={`${u.kategori} — vitrin örneği: ${u.vitrinMarka}`} loading="lazy" decoding="async" />
            </div>
            <div class="kart-govde">
              <p class="urun-vitrin">Vitrin örneği · {u.vitrinMarka}</p>
              <h2 class="kart-baslik">{u.kategori}</h2>
              <p class="kart-metin urun-aciklama">{u.aciklama}</p>
              <ul class="urun-ozellik">
                {u.ozellikler.map((o) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
              <a class="btn btn-fill urun-cta" href="/iletisim/">Bilgi al</a>
            </div>
          </article>
        ))}
      </div>

      <aside class="urun-marka-bilgi" aria-label="Diğer marka tedariki">
        <p>
          <strong>Farklı marka tercih ediyorsanız:</strong> Yukarıdaki Bosch
          modelleri vitrinimizdeki örneklerdir. Klima, kombi, ısı pompası ve VRF
          sistemlerinde ihtiyacınıza ve bütçenize uygun farklı marka ve modeller
          için keşif sırasında birlikte değerlendirme yapıyoruz.
        </p>
        <a class="btn btn-fill" href="/iletisim/#kesif-formu">Keşif talebi oluştur</a>
      </aside>
    </div>
  </section>
</Layout>

<style is:global>
  .urun-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .urun-kart .kart-metin { flex: 0 0 auto; }
  .urun-aciklama { margin-bottom: var(--space-2); }

  .urun-ozellik {
    list-style: none;
    padding: var(--space-6) 0 0;
    margin: var(--space-6) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .urun-ozellik li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .urun-ozellik svg {
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    margin-top: 3px;
    color: var(--color-primary);
  }
  .urun-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* Vitrin marka etiketi — kart başlığının üstünde küçük üst etiket */
  .urun-vitrin {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-deep, var(--color-primary));
    margin: 0 0 var(--space-2) 0;
    opacity: 0.85;
  }

  /* Alt bilgi bloğu — diğer marka tedariki */
  .urun-marka-bilgi {
    margin-top: var(--space-12);
    padding: var(--space-8) var(--space-8);
    background: var(--color-primary-soft, rgba(107, 159, 53, 0.08));
    border-left: 4px solid var(--color-primary, #6B9F35);
    border-radius: var(--radius-md, 8px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .urun-marka-bilgi p {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    max-width: 65ch;
  }
  .urun-marka-bilgi p strong {
    color: var(--color-text-strong, currentColor);
  }
</style>
