---
import Layout from "../layouts/Layout.astro";

/* Ürün özellikleri Bosch'un resmî ürün bilgisinden — teknik veriler (olgu).
   Klima/kombi görselleri Bosch ürün görselleri; ısı pompası görseli geçici
   (genel görsel) — Bosch Compress görseli partner portalından gelince güncellenir. */
const urunler = [
  {
    baslik: "Bosch Climate Serisi Klima",
    aciklama:
      "Konut ve iş yerleri için yüksek verimli inverter split klima — yaz serinliği, kış ısısı tek cihazda.",
    gorsel: "/images/bosch-klima-hd.webp",
    urun: true,
    ozellikler: [
      "A++ enerji sınıfı, çevre dostu R-32 soğutucu gaz",
      "Turbo ve uyku modu, kolay sökülüp temizlenen filtre",
      "9.000 / 12.000 / 18.000 / 24.000 / 48.000 BTU kapasite seçenekleri",
    ],
  },
  {
    baslik: "Bosch Condens Yoğuşmalı Kombi",
    aciklama:
      "Tam yoğuşma teknolojisiyle tasarruflu, dengeli ve sessiz ısınma — konut ve daireler için.",
    gorsel: "/images/bosch-kombi-hd.webp",
    urun: true,
    ozellikler: [
      "Tam yoğuşma teknolojisi — yüksek ısıl verim",
      "Paslanmaz çelik ısı eşanjörü ile uzun ömür",
      "Kademesiz modülasyon — anlık ihtiyaca göre kapasite",
      "47 dB altı sessiz çalışma",
    ],
  },
  {
    baslik: "Bosch Compress Isı Pompası",
    aciklama:
      "Hava kaynaklı ısı pompasıyla tek sistemde ısıtma, soğutma ve sıcak kullanım suyu.",
    gorsel: "/images/bosch-isipompasi-hd.webp",
    urun: true,
    ozellikler: [
      "A+++ ErP verimlilik sınıfı, yüksek SCOP değeri",
      "Inverter kompresör — ihtiyaca göre çalışma hızı",
      "Isıtma + soğutma + sıcak su, tek ünitede",
      "8 / 10 / 14 kW kapasite, R-32 soğutucu gaz",
    ],
  },
  {
    baslik: "Bosch VRF Klima Sistemi",
    aciklama:
      "Otel, iş merkezi ve büyük binalar için tek dış üniteyle çok bölgeli iklimlendirme.",
    gorsel: "/images/bosch-vrf-hd.webp",
    urun: true,
    ozellikler: [
      "Tek dış üniteyle 4–12 bağımsız bölge kontrolü",
      "Inverter DC kompresör — üst sınıf enerji verimliliği",
      "Otel, hastane, okul ve villa gibi büyük yapılara uygun",
      "Bina yönetim sistemine entegre merkezi kontrol",
    ],
  },
];

/* ── SCHEMA: ItemList + Product (enriched) — Offer + Availability + Image
   Fiyat range yok (BNS onayı gerekene kadar), ama availability + areaServed
   + manufacturer (Bosch Organization) + ek alanlar Knowledge Graph derinliği. ── */
const urunSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "https://bnsenerjidogalgaz.com/urunler/#products",
  name: "BNS Enerji & Doğalgaz — Bosch Ürünleri",
  numberOfItems: urunler.length,
  itemListElement: urunler.map((u, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      "@id": `https://bnsenerjidogalgaz.com/urunler/#product-${i + 1}`,
      name: u.baslik,
      description: u.aciklama,
      image: `https://bnsenerjidogalgaz.com${u.gorsel}`,
      brand: {
        "@type": "Brand",
        name: "Bosch",
        url: "https://www.bosch.com.tr/",
      },
      manufacturer: {
        "@type": "Organization",
        name: "Bosch Thermotechnik",
        url: "https://www.bosch-thermotechnology.com/",
      },
      category: "HVAC / İklimlendirme, Isıtma ve Soğutma Sistemleri",
      additionalProperty: u.ozellikler.map((o) => ({
        "@type": "PropertyValue",
        value: o,
      })),
      offers: {
        "@type": "Offer",
        availability: "https://schema.org/InStock",
        priceCurrency: "TRY",
        priceSpecification: {
          "@type": "PriceSpecification",
          priceCurrency: "TRY",
          valueAddedTaxIncluded: true,
        },
        seller: { "@id": "https://bnsenerjidogalgaz.com/#business" },
        areaServed: [
          { "@type": "City", name: "Polatlı" },
          { "@type": "AdministrativeArea", name: "Ankara" },
        ],
        url: "https://bnsenerjidogalgaz.com/iletisim/",
      },
    },
  })),
};
---

<Layout
  title="Polatlı Bosch Klima, Kombi, Isı Pompası ve VRF | BNS Enerji"
  description="Polatlı'da Bosch Climate klima, Bosch Condens yoğuşmalı kombi, Bosch Compress ısı pompası ve Bosch VRF klima sistemleri. BNS Enerji & Doğalgaz — Bosch Partner Program üyesi, orijinal ürün."
  extraSchemas={[urunSchema]}
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Ürünler</p>
        <h1 class="page-title">Bosch klima, kombi, ısı pompası ve VRF</h1>
        <p class="page-intro">
          Bosch Partner Program üyesi olarak orijinal Bosch ürünleri sunuyoruz —
          klima ve kombide üretici güvencesi, ısı pompasında verimli çözüm.
        </p>
      </header>

      <div class="urun-grid">
        {urunler.map((u) => (
          <article class="kart kart-gorselli urun-kart">
            <div class:list={["kart-foto", { "kart-foto-urun": u.urun }]}>
              <img src={u.gorsel} alt={u.baslik} loading="lazy" decoding="async" />
            </div>
            <div class="kart-govde">
              <h2 class="kart-baslik">{u.baslik}</h2>
              <p class="kart-metin urun-aciklama">{u.aciklama}</p>
              <ul class="urun-ozellik">
                {u.ozellikler.map((o) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
              <a class="btn btn-fill urun-cta" href="/iletisim/">Bilgi al</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .urun-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .urun-kart .kart-metin { flex: 0 0 auto; }
  .urun-aciklama { margin-bottom: var(--space-2); }

  .urun-ozellik {
    list-style: none;
    padding: var(--space-6) 0 0;
    margin: var(--space-6) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .urun-ozellik li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .urun-ozellik svg {
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    margin-top: 3px;
    color: var(--color-primary);
  }
  .urun-cta {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
