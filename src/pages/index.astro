---
import Layout from "../layouts/Layout.astro";

const hizmetler = [
  {
    baslik: "Polatlı Doğalgaz Tesisatı",
    metin:
      "TS 7363 standardı ve Polgaz onaylı iç tesisat — borulama, vana, sızdırmazlık testi ve gaz açma tek elden.",
    href: "/hizmetler/dogalgaz-tesisati/",
    icon: `<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>`,
  },
  {
    baslik: "Polatlı Yoğuşmalı Kombi",
    metin:
      "Yetkili marka A sınıfı yoğuşmalı kombi satışı + üreticinin yetkili servisi montajı. Mevcut kombiyi yenilemek için kombi değişimi de yapılır.",
    href: "/hizmetler/kombi/",
    icon: `<path d="M4 4h16v16H4z"/><path d="M4 9h16M9 14h.01M13 14h.01"/><path d="M8 4v5M16 4v5"/>`,
  },
  {
    baslik: "Polatlı Klima ve VRF",
    metin:
      "Yetkili marka split, multisplit ve VRF sistemleri. Konuttan otele kadar her ölçekte iklimlendirme.",
    href: "/hizmetler/klima/",
    icon: `<path d="M3 7h18M3 12h18M3 17h18M7 4v3M12 4v3M17 4v3M7 14v3M12 14v3M17 14v3"/>`,
  },
  {
    baslik: "Polatlı Isı Pompası",
    metin:
      "Hava-su ısı pompası — COP 3-4 verimle ısıtma + soğutma + sıcak su tek sistemde.",
    href: "/hizmetler/isi-pompasi/",
    icon: `<path d="M14 14.76V5a2 2 0 0 0-4 0v9.76a4 4 0 1 0 4 0z"/><path d="M19 8h-3M19 4h-3M19 12h-3"/>`,
  },
  {
    baslik: "Polatlı Yerden Isıtma",
    metin:
      "35-45°C düşük su sıcaklığında çalışan, yoğuşmalı kombi ve ısı pompasıyla en verimli ısıtma sistemi.",
    href: "/hizmetler/yerden-isitma/",
    icon: `<path d="M3 6h18M3 12h18M3 18h18"/><path d="M6 3v18M12 3v18M18 3v18" stroke-dasharray="2 2"/>`,
  },
  {
    baslik: "Polatlı Yangın Söndürme",
    metin:
      "Sprinkler, gazlı (FM-200/Novec) ve köpüklü sistemler — Yangın Yönetmeliği 2007/12937 uyumlu kurulum.",
    href: "/hizmetler/yangin-sondurme/",
    icon: `<path d="M15 6.5V19a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V6.5"/><path d="M9 6.5a3 3 0 0 1 6 0"/><path d="M12 3.6V2M15 5h3a2 2 0 0 1 2 2v2"/><path d="M9 11h6"/>`,
  },
];

const surec = [
  { no: "01", baslik: "Keşif ve Ölçüm", metin: "Mekânınıza gelir, ihtiyacı yerinde inceler ve doğru ölçüyü alırız." },
  { no: "02", baslik: "Projelendirme", metin: "İhtiyaca uygun sistemi projelendirir, çözümü sizinle netleştiririz." },
  { no: "03", baslik: "Montaj", metin: "Standartlara uygun malzeme ve yetkili işçilikle kurulumu gerçekleştiririz." },
  { no: "04", baslik: "Devreye Alma", metin: "Sistemi devreye alır, güvenlik ve sızdırmazlık testlerinden geçiririz." },
];

/* ── KESİT — evin içindeki sistemler (işaret noktası → hizmet sayfası) ── */
const sistemler = [
  { no: "01", ad: "Doğalgaz Tesisatı", metin: "Sokak hattından kombiye, sızdırmazlık testli iç tesisat.", href: "/hizmetler/dogalgaz-tesisati/" },
  { no: "02", ad: "Merkezi & Kombi Isıtma", metin: "Yoğuşmalı kombi ve kazan sistemiyle dengeli ısınma.", href: "/hizmetler/merkezi-isitma/" },
  { no: "03", ad: "Yerden Isıtma", metin: "Zeminden eşit yayılan, radyatörsüz sıcaklık.", href: "/hizmetler/yerden-isitma/" },
  { no: "04", ad: "Klima", metin: "Inverter klimayla sessiz yaz serinliği.", href: "/hizmetler/klima/" },
  { no: "05", ad: "Isı Pompası", metin: "Dış üniteyle havadan yüksek verimli ısıtma.", href: "/hizmetler/isi-pompasi/" },
  { no: "06", ad: "Yangın Söndürme", metin: "Konut ve işyeri için yangın güvenlik sistemleri.", href: "/hizmetler/yangin-sondurme/" },
];

const urunler = [
  { baslik: "Klima", metin: "Inverter teknolojisi, A++ verimlilik ve sessiz çalışma — yaz konforu için.", gorsel: "/images/bosch-klima-hd.webp" },
  { baslik: "Kombi", metin: "Yoğuşmalı kombi sistemleriyle tasarruflu ve dengeli ısınma.", gorsel: "/images/bosch-kombi-hd.webp" },
];

const referanslar = [
  { ad: "Polatlı Belediye Binası", is: "Doğalgaz tesisatı", icon: `<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>` },
  { ad: "Polatlı Ticaret Odası", is: "Yerden ısıtma + doğalgaz", icon: `<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 1.3 0 1.9-.5 2.5-1M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 1.3 0 1.9-.5 2.5-1M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 1.3 0 1.9-.5 2.5-1"/>` },
  { ad: "Polatlı Şehir Stadı", is: "Isıtma + kazan sistemleri", icon: `<path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/><path d="M12 5v9"/>` },
  { ad: "Polatlı Öğretmenevi", is: "Oda klima sistemleri", vurgu: "27" },
];

const yetkiler = [
  {
    baslik: "Yetkili Marka Tedarik",
    metin: "İhtiyaca uygun yetkili marka klima ve yoğuşmalı kombi tedariki — üretici garantisi ve yetkili servis montajı standart.",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    baslik: "Polgaz Yetkili Tesisat",
    metin: "Polatlı doğalgaz dağıtıcısı Polgaz onaylı iç tesisat firması.",
    icon: `<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>`,
  },
];

const sss = [
  { s: "Doğalgaz iç tesisatı nasıl bir süreçle yapılıyor?", c: "Keşif ve ölçümle başlıyoruz; ardından projelendirme, dağıtım şirketi onayı, tesisat montajı ve kontrol aşamalarıyla sistem devreye alınıyor." },
  { s: "Klima montajını siz mi yapıyorsunuz?", c: "Klima satışını BNS Enerji yapıyor; montaj, üreticinin yetkili servisi tarafından gerçekleştiriliyor — tek elden üretici güvencesiyle koordine ediyoruz." },
  { s: "Hangi bölgelere hizmet veriyorsunuz?", c: "Polatlı merkez ve çevresine doğalgaz, ısıtma, klima ve yangın söndürme sistemleri hizmeti veriyoruz." },
  { s: "Keşif için nasıl randevu alabilirim?", c: "Telefon ya da WhatsApp üzerinden bize ulaşarak keşif ve ölçüm talebi oluşturabilirsiniz." },
];

const istatistik = [
  { num: "14", label: "Kurumsal referans projesi" },
  { num: "6", label: "Uzmanlık ve hizmet alanı" },
  { num: "2020", label: "Polatlı'da hizmet başlangıcı" },
];
const istatistikNot =
  "Polgaz yetkili iç tesisat firması — yetkili marka klima, kombi ve ısı pompası tedariki.";

/* ── SCHEMA: FAQPage ── */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: sss.map((q) => ({
    "@type": "Question",
    name: q.s,
    acceptedAnswer: { "@type": "Answer", text: q.c },
  })),
};
---

<Layout
  title="BNS Enerji & Doğalgaz — Polatlı Doğalgaz, Klima, Isı Pompası"
  description="Polatlı/Ankara'da doğalgaz tesisatı, klima, ısı pompası, yangın söndürme ve merkezi ısıtma sistemleri. BNS Enerji & Doğalgaz — Geleceğin Enerjisini Bugün Sunuyoruz."
  extraSchemas={[faqSchema]}
>
  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="container hero-grid">
      <span class="hero-vlabel" aria-hidden="true">EST. 2020 — POLATLI</span>

      <div class="hero-text">
        <p class="hero-kicker">
          <span class="hero-tick" aria-hidden="true"></span>
          Polatlı · Doğalgaz · Klima · Isı Pompası
        </p>
        <h1 class="hero-title">
          Polatlı'da enerjinin
          <span class="hero-accent">güvenilir adresi.</span>
        </h1>
        <p class="hero-lede">
          Doğalgaz tesisatından klima ve ısı pompasına — keşiften devreye
          almaya tek elden, Polgaz yetkili firma ve yetkili marka
          güvencesiyle yanınızdayız.
        </p>
        <div class="hero-actions">
          <a class="btn btn-fill" href="/iletisim/#kesif-formu">Keşif talebi oluştur</a>
          <a class="btn hero-tel" href="tel:+905324993986">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z" />
            </svg>
            0 532 499 39 86
          </a>
        </div>
      </div>

      <figure class="hero-media">
        <span class="hero-frame" aria-hidden="true"></span>
        <picture>
          <source
            type="image/avif"
            srcset="/images/dukkan-vitrin-480.avif 480w, /images/dukkan-vitrin-540.avif 540w, /images/dukkan-vitrin-720.avif 720w, /images/dukkan-vitrin-960.avif 960w, /images/dukkan-vitrin-1080.avif 1080w"
            sizes="(max-width: 920px) 100vw, 44vw"
          />
          <source
            type="image/webp"
            srcset="/images/dukkan-vitrin-480.webp 480w, /images/dukkan-vitrin-540.webp 540w, /images/dukkan-vitrin-720.webp 720w, /images/dukkan-vitrin-960.webp 960w, /images/dukkan-vitrin-1080.webp 1080w"
            sizes="(max-width: 920px) 100vw, 44vw"
          />
          <img
            src="/images/dukkan-vitrin.jpg"
            alt="BNS Enerji & Doğalgaz'ın Polatlı Fatih Mahallesi'ndeki mağaza ve showroom girişi"
            width="1080"
            height="1306"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <figcaption class="hero-namecard">
          <span class="hero-namecard-bar" aria-hidden="true"></span>
          <span class="hero-namecard-text">
            <strong>BNS Enerji &amp; Doğalgaz</strong>
            <em>Polatlı · Fatih Mahallesi mağaza</em>
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ─── İSTATİSTİK ŞERİDİ ─── -->
  <section class="stat-serit">
    <div class="container stat-grid">
      {istatistik.map((s, i) => {
        const sayi = Number(s.num);
        const sayilabilir = !Number.isNaN(sayi) && sayi < 200;
        return (
          <div class={`stat ${i === 0 ? "stat-accent" : ""}`}>
            <span
              class={`stat-num ${sayilabilir ? "stat-num-count" : ""}`}
              style={sayilabilir ? `--target: ${sayi}` : undefined}
            >{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        );
      })}
      <p class="stat-not">{istatistikNot}</p>
    </div>
  </section>

  <!-- ─── 01 · HİZMET ALANLARI ─── -->
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="bolum-head bolum-head-split">
        <div>
          <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Hizmet Alanlarımız</p>
          <h2 class="bolum-title">Enerjiyi güvenle taşıyan çözümler</h2>
        </div>
        <p class="bolum-aciklama">
          Doğalgaz tesisatından yangın güvenliğine — konut, ticari ve sanayi
          yapılarında uçtan uca uygulama.
        </p>
      </header>
      <div class="kart-grid g-3">
        {hizmetler.map((h, i) => (
          <a class="kart kart-link" href={h.href}>
            <div class="kart-ust">
              <span class="kart-ikon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="26" height="26" set:html={h.icon} />
              </span>
              <span class="kart-sira" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <h3 class="kart-baslik">{h.baslik}</h3>
            <p class="kart-metin">{h.metin}</p>
            <span class="kart-ok">Detaylar →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 02 · KESİT — Görünür Tesisat ─── -->
  <section class="bolum bolum-soft kesit">
    <div class="container">
      <header class="bolum-head">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Görünür Tesisat</p>
        <h2 class="bolum-title">Duvarın içini biz biliriz</h2>
        <p class="kesit-intro">
          Bir evi ısıtan, serinleten ve güvene alan sistemlerin çoğu sıvanın
          altında, gözden uzakta çalışır. BNS Enerji o görünmeyen işçiliği
          planlar, kurar ve teker teker test eder.
        </p>
      </header>

      <div class="kesit-sahne">
        <ol class="kesit-liste">
          {sistemler.map((s) => (
            <li>
              <a class="kesit-madde" href={s.href}>
                <span class="kesit-madde-no" aria-hidden="true">{s.no}</span>
                <span class="kesit-madde-govde">
                  <span class="kesit-madde-ad">{s.ad}</span>
                  <span class="kesit-madde-metin">{s.metin}</span>
                </span>
                <span class="kesit-madde-ok" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>

        <figure class="kesit-cizim">
          <svg class="kesit-svg" viewBox="0 0 700 510" role="img"
            aria-label="Bir evin kesit görünümü: BNS Enerji'nin kurduğu doğalgaz hattı, kombi, yerden ısıtma, klima, ısı pompası ve yangın algılama sistemleri evin içinde işaretlenmiş."
            xmlns="http://www.w3.org/2000/svg">
            <!-- zemin + toprak -->
            <line class="k-zemin" x1="16" y1="446" x2="684" y2="446" />
            <path class="k-toprak" d="M70 460l-9 12M150 458l-9 12M250 460l-9 12M360 458l-9 12M470 460l-9 12M560 458l-9 12" />

            <!-- ev yapısı: çatı + duvarlar + döşeme (kesit poşesi) -->
            <polygon class="k-yapi" points="96,168 276,72 470,168" />
            <polyline class="k-cizgi-ince" points="124,166 276,98 442,166" />
            <rect class="k-oda" x="108" y="168" width="350" height="132" />
            <rect class="k-oda" x="108" y="311" width="350" height="123" />
            <rect class="k-yapi" x="96" y="168" width="12" height="278" />
            <rect class="k-yapi" x="458" y="168" width="12" height="278" />
            <rect class="k-yapi" x="108" y="300" width="350" height="11" />
            <rect class="k-yapi" x="108" y="434" width="350" height="12" />

            <!-- pencereler + kapı -->
            <rect class="k-pencere" x="140" y="206" width="56" height="46" />
            <path class="k-bolme" d="M168 206v46M140 229h56" />
            <rect class="k-pencere" x="330" y="330" width="68" height="58" />
            <path class="k-bolme" d="M364 330v58M330 359h68" />
            <rect class="k-kapi" x="230" y="372" width="54" height="62" />
            <circle class="k-yesil-dolu" cx="274" cy="404" r="3" />

            <!-- 1 · doğalgaz hattı -->
            <path class="k-gaz" d="M24 468H120V356H150" />
            <path class="k-gaz-akis" d="M24 468H120V356H150" />

            <!-- 2 · kombi -->
            <path class="k-detay" d="M164 330v-20M184 330v-20" />
            <rect class="k-kasa" x="150" y="330" width="48" height="56" rx="3" />
            <line class="k-detay" x1="158" y1="344" x2="190" y2="344" />
            <circle class="k-detay" cx="174" cy="364" r="11" />
            <path class="k-yesil-dolu" d="M174 357c-4 4-4 8 0 11 4-3 4-7 0-11Z" />

            <!-- 3 · yerden ısıtma -->
            <path class="k-yesil" d="M292 432H432a4 4 0 0 0 0-8H296a4 4 0 0 1 0-8H438" />

            <!-- 4 · klima iç ünite -->
            <rect class="k-kasa" x="356" y="196" width="84" height="22" rx="4" />
            <path class="k-detay" d="M364 203h66M364 208h66M364 213h52" />
            <path class="k-yesil" d="M372 230l4 5 4-5M396 234l4 5 4-5" />

            <!-- 5 · ısı pompası dış ünite -->
            <path class="k-yesil" d="M470 406H548" />
            <rect class="k-pompa-kasa" x="548" y="388" width="86" height="58" rx="3" />
            <circle class="k-yesil" cx="582" cy="414" r="17" />
            <path class="k-yesil" d="M582 414v-17M582 414l15 9M582 414l-15 9" />
            <path class="k-detay" d="M610 402h16M610 410h16M610 418h16" />

            <!-- 6 · yangın algılama -->
            <path class="k-detay" d="M240 168v4" />
            <circle class="k-kasa" cx="240" cy="183" r="11" />
            <circle class="k-yesil-dolu" cx="240" cy="183" r="3.4" />
            <path class="k-yesil-koyu" d="M223 197a24 24 0 0 0 34 0" opacity="0.5" />

            <!-- işaret noktaları -->
            <g class="hs hs-1"><circle class="hs-dot" cx="66" cy="468" r="15" /><text class="hs-no" x="66" y="473">1</text></g>
            <g class="hs hs-2"><circle class="hs-dot" cx="198" cy="330" r="15" /><text class="hs-no" x="198" y="335">2</text></g>
            <g class="hs hs-3"><circle class="hs-dot" cx="420" cy="406" r="15" /><text class="hs-no" x="420" y="411">3</text></g>
            <g class="hs hs-4"><circle class="hs-dot" cx="397" cy="188" r="15" /><text class="hs-no" x="397" y="193">4</text></g>
            <g class="hs hs-5"><circle class="hs-dot" cx="591" cy="374" r="15" /><text class="hs-no" x="591" y="379">5</text></g>
            <g class="hs hs-6"><circle class="hs-dot" cx="276" cy="183" r="15" /><text class="hs-no" x="276" y="188">6</text></g>

            <!-- pafta amblemi -->
            <text class="k-amblem" x="672" y="496" text-anchor="end">KESİT — BNS ENERJİ</text>
          </svg>
          <figcaption class="kesit-altyazi">Bir konutta BNS'in dokunduğu sistemler — kesit görünümü.</figcaption>
        </figure>
      </div>

      <div class="kesit-surec">
        <p class="kesit-surec-kicker"><span class="kicker-tick" aria-hidden="true"></span>Her sistemde aynı yol</p>
        <ol class="kesit-surec-akis">
          {surec.map((s) => (
            <li class="kesit-adim">
              <span class="kesit-adim-no">{s.no}</span>
              <h3 class="kesit-adim-baslik">{s.baslik}</h3>
              <p class="kesit-adim-metin">{s.metin}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ─── 03 · ÜRÜNLER ─── -->
  <section class="bolum bolum-beyaz">
    <div class="container bosch-split">
      <div class="bosch-metin">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Yetkili Marka Tedarik</p>
        <h2 class="bolum-title">Klima ve kombi sistemleri</h2>
        <p class="bolum-aciklama">
          İhtiyaca uygun yetkili marka klima ve yoğuşmalı kombi tedarik edilir;
          üretici garantisi ve yetkili servis montajı standart.
        </p>
        <a class="bolum-link" href="/urunler/">Tüm ürünleri gör →</a>
      </div>
      <div class="bosch-urunler">
        {urunler.map((b) => (
          <article class="bosch-urun">
            <div class="bosch-urun-foto">
              <img src={b.gorsel} alt={b.baslik} loading="lazy" decoding="async" />
            </div>
            <div class="bosch-urun-govde">
              <h3 class="kart-baslik">{b.baslik}</h3>
              <p class="kart-metin">{b.metin}</p>
            </div>
