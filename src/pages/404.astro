---
import Layout from "../layouts/Layout.astro";
import { hizmetler } from "../data/hizmetler";
---

<Layout
  title="Sayfa bulunamadı — BNS Enerji & Doğalgaz"
  description="Aradığınız sayfa taşınmış veya kaldırılmış olabilir. BNS Enerji & Doğalgaz hizmet sayfalarına geri dönebilirsiniz."
  noindex={true}
>
  <section class="page-inner notfound">
    <div class="container">
      <p class="nf-kod">404</p>
      <h1 class="page-title">Aradığınız sayfayı bulamadık</h1>
      <p class="nf-aciklama">
        Sayfa taşınmış, kaldırılmış veya bağlantı hatalı olabilir. Aşağıdaki
        hizmetlerimize göz atabilir ya da anasayfaya dönebilirsiniz.
      </p>

      <div class="nf-cta">
        <a class="btn btn-fill" href="/">Anasayfaya dön</a>
        <a class="btn btn-soft" href="/hizmetler/">Tüm hizmetler</a>
        <a class="btn btn-soft" href="/iletisim/">İletişim</a>
      </div>

      <nav class="nf-hizmetler" aria-label="Hizmet listesi">
        <span class="nf-label">Hizmetlerimiz</span>
        <ul>
          {hizmetler.map((h) => (
            <li>
              <a href={`/hizmetler/${h.slug}/`}>
                Polatlı {h.kisaAd}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Layout>

<style is:global>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .nf-kod {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: var(--weight-extrabold);
    color: var(--color-primary);
    letter-spacing: var(--tracking-tighter);
    line-height: 1;
    margin-bottom: var(--space-3);
  }
  .nf-aciklama {
    margin-top: var(--space-5);
    max-width: 56ch;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }
  .nf-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .nf-hizmetler {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .nf-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .nf-hizmetler ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .nf-hizmetler a {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--color-text-body);
    transition:
      border-color var(--duration-base) var(--ease-bns),
      color var(--duration-base) var(--ease-bns);
  }
  .nf-hizmetler a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-deep);
  }
</style>
