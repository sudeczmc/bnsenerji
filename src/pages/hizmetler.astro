---
import Layout from "../layouts/Layout.astro";
import { hizmetler } from "../data/hizmetler";

const sayfaURL = "https://bnsenerjidogalgaz.com/hizmetler/";

/* Hub için Service collection + global FAQ */
const hubSss = [
  { s: "Hangi hizmet ne zaman gerekir?", c: "Yeni konut veya iş yeri yapımında doğalgaz tesisatı + yerden ısıtma + kombi kombinasyonu. Mevcut binada modernizasyon için kombi değişimi veya ısı pompası dönüşümü. Çok bölümlü ticari yapılarda VRF klima sistemi. Yasal yapılarda yangın söndürme zorunlu. Anasayfadaki kesit çiziminden hangi sistemin nereye konduğunu görebilirsiniz." },
  { s: "Hangi marka klima, kombi veya ısı pompası tedarik ediyorsunuz?", c: "Tek marka münhasır temsilcisi değiliz — müşterinin isteğine ve bütçesine göre marka ve model birlikte seçilir. Klima, yoğuşmalı kombi, ısı pompası ve VRF sistemlerinde isteğinize uygun markada tedarik yapılır. Ürün ve montaj üretici garantisi kapsamındadır; montaj üreticinin yetkili servisi tarafından gerçekleştirilir." },
  { s: "Keşif ücretsiz mi, randevu nasıl alınır?", c: "Polatlı merkez ve çevresinde yerinde keşif ve ölçüm ücretsizdir. Telefon (0 532 499 39 86) veya WhatsApp üzerinden randevu alınabilir; iletişim sayfasındaki keşif talebi formu da kullanılabilir." },
  { s: "Hangi bölgelere hizmet veriyorsunuz?", c: "Hizmet bölgesi projenin türü ve kapsamına göre değişir. Polatlı ağırlıklı çalışıyoruz; özel projeler için iletişim sayfasından bize ulaşabilirsiniz." },
  { s: "Tüm hizmetler tek elden mi yürütülüyor?", c: "Evet. Keşif, projelendirme, ürün tedariki, kurulum, devreye alma ve teslim — tüm süreç BNS Enerji koordinasyonunda yürür. Klima montajı üreticinin yetkili servisi tarafından yapılır, ancak müşterinin tek muhatabı BNS Enerji'dir." },
  { s: "Standart çalışma akışı nedir?", c: "Tüm hizmetlerde aynı disiplin: 1) Yerinde keşif ve ölçüm, 2) Projelendirme ve teklif, 3) Uygulama ve montaj, 4) Test, sızdırmazlık ve devreye alma. Doğalgazda dağıtım şirketi onayı + sızdırmazlık testi; yangın söndürmede hidrostatik test; klima/ısı pompasında sistem fonksiyon testi." },
];

const hubFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": sayfaURL + "#faq",
  mainEntity: hubSss.map((q) => ({
    "@type": "Question",
    name: q.s,
    acceptedAnswer: { "@type": "Answer", text: q.c },
  })),
};

const hubCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": sayfaURL + "#collection",
  url: sayfaURL,
  name: "BNS Enerji & Doğalgaz — Tesisat ve İklimlendirme Hizmetleri",
  description: "Polatlı/Ankara'da doğalgaz tesisatı, kombi, ısı pompası, klima, VRF, yerden ısıtma, merkezi ısıtma ve yangın söndürme sistemleri.",
  about: { "@id": "https://bnsenerjidogalgaz.com/#business" },
  hasPart: hizmetler.map((h) => ({
    "@type": "Service",
    name: `Polatlı ${h.kisaAd}`,
    url: `https://bnsenerjidogalgaz.com/hizmetler/${h.slug}/`,
  })),
};

const standartSurec = [
  { no: "01", baslik: "Yerinde Keşif", metin: "Mekân ölçüldü, mevcut sistem ve ihtiyaç analiz edilir." },
  { no: "02", baslik: "Projelendirme", metin: "İhtiyaca uygun sistem seçilir, teknik şartnameye göre projelendirilir." },
  { no: "03", baslik: "Uygulama", metin: "Onaylı projeye göre montaj — doğalgazda Polgaz onayı, klima/ısı pompasında üreticinin yetkili servisi koordinasyonu." },
  { no: "04", baslik: "Test ve Devreye Alma", metin: "Sızdırmazlık, basınç ve fonksiyon testleri sonrası sistem teslim edilir; kullanım ve güvenlik rehberi paylaşılır." },
];
---

<Layout
  title="Polatlı Doğalgaz, Klima, Isı Pompası Hizmetleri | BNS Enerji"
  description="Polatlı'da doğalgaz tesisatı, kombi, ısı pompası, klima, VRF, yerden ısıtma, merkezi ısıtma ve yangın söndürme. Polgaz yetkili + isteğinize uygun markada tedarik — keşiften devreye almaya tek elden."
  extraSchemas={[hubCollectionSchema, hubFaqSchema]}
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Hizmetlerimiz</p>
        <h1 class="page-title">Konut, iş yeri ve endüstri için tesisat çözümleri</h1>
        <p class="page-intro">
          <strong>BNS Enerji & Doğalgaz, Polatlı/Ankara merkezli — doğalgaz
          tesisatı, kombi, ısı pompası, klima, yangın söndürme, yerden ısıtma
          ve merkezi ısıtma sistemleri alanında uçtan uca uygulama yapan
          tesisat firmasıdır.</strong>
          Keşiften devreye almaya kadar tüm süreç tek elden yürütülür; doğalgazda
          Polgaz onayı, klima/kombi/ısı pompası/VRF'de isteğinize uygun markada
          orijinal ürün ve üreticinin yetkili servis montajı, yangın söndürmede
          Yangın Yönetmeliği (2007/12937) uyumlu uygulama.
        </p>
      </header>

      <aside class="hub-tldr" aria-label="Özet">
        <span class="hub-tldr-etiket" aria-hidden="true">Özet</span>
        <ul>
          <li><strong>9 hizmet alanı</strong> — doğalgaz, kombi, kombi değişimi, klima, VRF, ısı pompası, yangın söndürme, yerden ısıtma, merkezi ısıtma.</li>
          <li><strong>2020'den bu yana Polatlı</strong> — 14 kurumsal referans (Belediye, Ticaret Odası, Şehir Stadı, Yenimahalle Camii, Öğretmenevi 27 ünite vb.).</li>
          <li><strong>Yetki</strong> — Polgaz yetkili iç tesisat firması; klima, yoğuşmalı kombi ve ısı pompasında müşterinin isteğine göre marka tedariki.</li>
          <li><strong>Hizmet alanı</strong> — Polatlı merkez ve çevresi; hizmet bölgesi projenin türü ve kapsamına göre değişir.</li>
        </ul>
      </aside>

      <h2 class="bolum-title hub-bolum">Hizmet kategorileri</h2>
      <div class="kart-grid g-3">
        {hizmetler.map((h) => (
          <a class="kart kart-gorselli kart-link" href={`/hizmetler/${h.slug}/`}>
            <div class="kart-foto">
              <img src={h.gorsel} alt={h.ad} loading="lazy" decoding="async" />
            </div>
            <div class="kart-govde">
              <h3 class="kart-baslik">{h.kisaAd}</h3>
              <p class="kart-metin">{h.ozet}</p>
              <span class="kart-ok">Detayları gör →</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="bolum-title hub-bolum">Standart çalışma yöntemi</h2>
      <p class="hub-aciklama">
        Hangi hizmet olursa olsun aynı disiplini uyguluyoruz — projelendirmesiz
        montaj yok, testsiz teslim yok.
      </p>
      <ol class="hub-surec">
        {standartSurec.map((s) => (
          <li>
            <span class="hub-surec-no">{s.no}</span>
            <div>
              <h3>{s.baslik}</h3>
              <p>{s.metin}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="bolum-title hub-bolum">Yetki ve üyelikler</h2>
      <ul class="hub-yetki">
        <li>
          <strong>Polgaz yetkili iç tesisat firması</strong> — Polatlı doğalgaz dağıtım şirketi tarafından onaylı iç tesisat uygulayıcısı. Tüm doğalgaz iç tesisat projeleri Polgaz onayına sunulur.
        </li>
        <li>
          <strong>İsteğinize göre marka tedariki</strong> — klima, yoğuşmalı kombi, ısı pompası ve VRF sistemlerinde müşterinin tercihine ve bütçesine uygun markada orijinal ürün. Montaj üreticinin yetkili servisi tarafından, üretici garantisi tam.
        </li>
        <li>
          <strong>İSG uyumlu çalışma</strong> — şantiye ve montaj süreçlerinde iş sağlığı ve güvenliği protokolleri uygulanır.
        </li>
      </ul>

      <h2 class="bolum-title hub-bolum">Sıkça sorulan sorular</h2>
      <div class="hub-sss">
        {hubSss.map((q) => (
          <details class="hub-sss-item">
            <summary>{q.s}</summary>
            <p>{q.c}</p>
          </details>
        ))}
      </div>

      <div class="bolum-cta cta-ikili hub-cta">
        <a class="btn btn-fill" href="/iletisim/#kesif-formu">Keşif talebi oluştur</a>
        <a class="btn btn-soft" href="/referanslar/">Referans projelerimiz</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .hub-bolum {
    margin-top: clamp(3rem, 6vw, 5rem);
    margin-bottom: var(--space-6);
  }
  .hub-tldr {
    margin: var(--space-10) 0 var(--space-4);
    padding: var(--space-6) var(--space-7);
    background: var(--color-primary-bg);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    max-width: 880px;
  }
  .hub-tldr-etiket {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-deep);
    margin-bottom: var(--space-3);
  }
  .hub-tldr ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .hub-tldr li {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .hub-tldr strong { color: var(--color-text); font-weight: var(--weight-semibold); }

  .hub-aciklama {
    max-width: 760px;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-body);
    margin-bottom: var(--space-8);
  }

  .hub-surec {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
  }
  .hub-surec li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
  }
  .hub-surec-no {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
  }
  .hub-surec h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .hub-surec p {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }

  .hub-yetki {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .hub-yetki li {
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-primary);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .hub-yetki strong { color: var(--color-text); font-weight: var(--weight-semibold); display: block; margin-bottom: var(--space-1); }

  .hub-sss {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hub-sss-item {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
  }
  .hub-sss-item summary {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .hub-sss-item summary::-webkit-details-marker { display: none; }
  .hub-sss-item summary::after {
    content: "+";
    color: var(--color-primary);
    font-size: 1.4em;
    line-height: 1;
    flex-shrink: 0;
  }
  .hub-sss-item[open] summary::after { content: "−"; }
  .hub-sss-item p {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }

  .hub-cta {
    margin-top: var(--space-12);
  }
</style>
