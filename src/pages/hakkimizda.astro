---
import Layout from "../layouts/Layout.astro";

/* ── SSS — yalnızca doğrulanmış firma gerçekleri ── */
const sss = [
  {
    s: "BNS Enerji ne zaman kuruldu?",
    c: "BNS Enerji 2020 yılında kuruldu. Polatlı merkezli; doğalgaz tesisatı, kombi, klima, ısı pompası, yerden ısıtma, merkezi ısıtma ve yangın söndürme sistemleri kuruyor.",
  },
  {
    s: "BNS Enerji Polgaz yetkili firma mı?",
    c: "Evet. BNS Enerji, Polgaz yetkili iç tesisat firmasıdır; sertifika numarası PG-1065. Polgaz Sertifikalı Firmalar listesinde yer alır.",
  },
  {
    s: "BNS Enerji hangi bölgelere hizmet veriyor?",
    c: "Hizmet bölgesi projenin türü ve kapsamına göre değişir. Polatlı ağırlıklı çalışıyoruz; özel projeler için iletişime geçebilirsiniz.",
  },
  {
    s: "Klima ve kombide hangi markaları tedarik ediyorsunuz?",
    c: "Klima, kombi ve ısı pompasında markadan bağımsız çalışıyoruz; müşterinin isteğine uygun markada tedarik ediyoruz. Montaj ve garanti üreticinin yetkili servisi üzerinden yürür.",
  },
  {
    s: "BNS Enerji periyodik bakım yapıyor mu?",
    c: "BNS Enerji keşif, projelendirme, montaj, devreye alma ve sızdırmazlık testlerini yürütür. Periyodik bakım ve servis, ürünün yetkili servisi tarafından yapılır.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://bnsenerjidogalgaz.com/hakkimizda/#faq",
  mainEntity: sss.map((q) => ({
    "@type": "Question",
    name: q.s,
    acceptedAnswer: { "@type": "Answer", text: q.c },
  })),
};
---

<Layout
  title="Hakkımızda — Polatlı'nın Enerji ve Tesisat Firması | BNS"
  description="BNS Enerji, Polatlı'da 2020'den bu yana doğalgaz, kombi, klima, ısı pompası ve yangın söndürme sistemleri kuruyor. Polgaz Sertifikalı (PG-1065), 14 kurumsal proje."
  extraSchemas={[faqSchema]}
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Hakkımızda</p>
        <h1 class="page-title">Enerjiyi güvenle taşıyoruz</h1>
      </header>

      <div class="hakkimizda-split">
        <div class="hakkimizda-metin">
          <p class="page-intro">
            <strong>BNS Enerji, Polatlı'da doğalgaz tesisatı, kombi, klima, ısı
            pompası, yerden ısıtma, merkezi ısıtma ve yangın söndürme sistemleri
            kuruyor.</strong> Polgaz Sertifikalı (PG-1065) iç tesisat firması;
            klima, kombi ve ısı pompasında müşterinin isteğine göre marka
            tedariki ile konut, ticari ve sanayi yapılarında çalışıyoruz.
          </p>
          <div class="metin-blok">
            <p>
              2020'den bu yana <strong>Polatlı Belediyesi, Ticaret Odası ve
              Şehir Stadı</strong> dahil 14 kurumsal projeyi teslim ettik. Her
              tesisatı <strong>TS 7363, TS EN 1775 ve dağıtım şirketinin teknik
              şartnamesi</strong> uyumunda kuruyor, sızdırmazlık testiyle
              kapatıyoruz.
            </p>
            <p>
              Deneyimli ekibimiz her projede ulusal standartlara uygun, uzun
              ömürlü sistemler kuruyor.
            </p>
          </div>
        </div>

        <div class="kart-grid g-2 hakkimizda-yan-kartlar">
          <article class="kart">
            <span class="kart-etiket">Misyonumuz</span>
            <p class="kart-metin">
              Her tesisatı testten geçirip teslim etmek. Doğalgazda Polgaz onayı,
              klima ve kombide üretici garantisi, yangın söndürmede Yangın
              Yönetmeliği 2007/12937 uyumu — söz veriyorsak yazılı veriyoruz.
            </p>
          </article>
          <article class="kart">
            <span class="kart-etiket">Vizyonumuz</span>
            <p class="kart-metin">
              Her tesisatımız bir öncekinden daha az enerji yaksın, daha uzun
              çalışsın. Yüksek verimli sistemleri Polatlı'nın standart seçeneği
              yapmak.
            </p>
          </article>
        </div>
      </div>

      <div class="hk-sss-blok">
        <h2 class="hk-h2">Sık sorulan sorular</h2>
        <div class="hk-sss-list">
          {sss.map((q) => (
            <details class="hk-sss-item">
              <summary>{q.s}</summary>
              <p>{q.c}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="bolum-cta cta-ikili">
        <a class="btn btn-fill" href="/iletisim/">İletişim</a>
        <a class="btn btn-soft" href="/referanslar/">Referanslar</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .metin-blok {
    max-width: 760px;
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .metin-blok p {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-text-body);
  }
  .metin-blok strong { color: var(--color-text); font-weight: var(--weight-semibold); }
  .cta-ikili {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* ═══ Hakkımızda — split: sol page-intro+gövde metni / sağ misyon-vizyon kartları ═══ */
  .hakkimizda-split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
    margin-top: var(--space-10);
  }
  .hakkimizda-metin {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .hakkimizda-metin .page-intro { margin: 0; }
  .hakkimizda-split .metin-blok {
    max-width: none;
    margin-top: 0;
  }
  .hakkimizda-yan-kartlar {
    grid-template-columns: 1fr;
    margin-top: 0;
    gap: var(--space-5);
  }
  @media (max-width: 860px) {
    .hakkimizda-split {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  /* ═══ Hakkımızda SSS accordion ═══ */
  .hk-sss-blok { margin-top: var(--space-16); }
  .hk-h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }
  .hk-sss-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 820px;
  }
  .hk-sss-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-card-bg);
    overflow: hidden;
  }
  .hk-sss-item summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-5) var(--space-6);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .hk-sss-item summary::-webkit-details-marker { display: none; }
  .hk-sss-item summary::after {
    content: "+";
    font-size: 1.25rem;
    color: var(--color-primary);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .hk-sss-item[open] summary::after { content: "−"; }
  .hk-sss-item p {
    padding: 0 var(--space-6) var(--space-5);
    color: var(--color-text-body);
    line-height: var(--leading-loose);
  }
</style>
