---
import Layout from "../../layouts/Layout.astro";
import { karsilastirmalar } from "../../data/karsilastirma";

export async function getStaticPaths() {
  return karsilastirmalar.map((k) => ({
    params: { slug: k.slug },
    props: { karsilastirma: k },
  }));
}

const { karsilastirma: k } = Astro.props;
const sayfaURL = `https://bnsenerjidogalgaz.com/karsilastirma/${k.slug}/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": sayfaURL + "#article",
  headline: k.baslik,
  description: k.tldr,
  author: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
  publisher: { "@id": "https://bnsenerjidogalgaz.com/#organization" },
  inLanguage: "tr-TR",
  about: k.markalar.map((m) => ({ "@type": "Brand", name: m })),
  isPartOf: { "@id": "https://bnsenerjidogalgaz.com/#website" },
  mainEntityOfPage: sayfaURL,
  datePublished: "2026-05-25",
  dateModified: new Date().toISOString(),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": sayfaURL + "#faq",
  mainEntity: k.sss.map((q) => ({
    "@type": "Question",
    name: q.s,
    acceptedAnswer: { "@type": "Answer", text: q.c },
  })),
};
---

<Layout
  title={`${k.kisaBaslik} | BNS Enerji & Doğalgaz`}
  description={k.tldr}
  extraSchemas={[articleSchema, faqSchema]}
  breadcrumbs={[
    { name: "Anasayfa", href: "/" },
    { name: "Karşılaştırma", href: "/karsilastirma/" },
    { name: k.kisaBaslik, href: `/karsilastirma/${k.slug}/` },
  ]}
>
  <section class="bolum bolum-beyaz">
    <div class="container ka-head">
      <header class="section-head">
        <p class="eyebrow">{k.kicker}</p>
        <h1 class="page-title">{k.baslik}</h1>
        <p class="page-intro">{k.giris}</p>
      </header>

      <div class="hd-tldr">
        <p class="hd-tldr-kicker">TL;DR</p>
        <p>{k.tldr}</p>
      </div>
    </div>
  </section>

  {/* KARŞILAŞTIRMA TABLOSU */}
  <section class="bolum bolum-soft">
    <div class="container">
      <header class="bolum-head">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Teknik Karşılaştırma</p>
        <h2 class="bolum-title">Marka marka teknik karşılaştırma</h2>
        <p class="bolum-aciklama">
          Tablo verileri üreticilerin resmi teknik dokümantasyonundan derlenmiştir.
          Modele göre değişebilir; kesin değer için ilgili modelin teknik kitapçığı esastır.
        </p>
      </header>

      <div class="ka-tablo-kapsayici">
        <table class="ka-tablo">
          <thead>
            <tr>
              <th>Özellik</th>
              {k.markalar.map((m) => <th>{m}</th>)}
            </tr>
          </thead>
          <tbody>
            {k.satirlar.map((satir) => (
              <tr>
                <td class="ka-tablo-ozellik">{satir.ozellik}</td>
                {satir.degerler.map((d) => <td>{d}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* SENARYOLAR */}
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="bolum-head">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Hangi Durumda Hangisi</p>
        <h2 class="bolum-title">Kullanım senaryolarına göre tercih</h2>
      </header>
      <div class="ka-senaryo-list">
        {k.senaryolar.map((s) => (
          <article class="ka-senaryo">
            <h3 class="ka-senaryo-baslik">{s.baslik}</h3>
            <p class="ka-senaryo-metin">{s.metin}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* BNS NOTU */}
  <section class="bolum bolum-soft">
    <div class="container">
      <div class="ka-bns-blok">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>BNS Enerji'nin İşi</p>
        <h2 class="bolum-title">Marka bağımsız tedarik</h2>
        <p class="ka-bns-metin">{k.bnsNotu}</p>
        <div class="hero-actions">
          <a class="btn btn-fill" href="/iletisim/#kesif-formu">Ücretsiz keşif talebi</a>
          <a class="btn btn-soft" href="/urunler/">Ürünleri görüntüle</a>
        </div>
      </div>
    </div>
  </section>

  {/* SSS */}
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="bolum-head">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Sık Sorulan Sorular</p>
        <h2 class="bolum-title">Aklınızdaki sorular</h2>
      </header>
      <div class="sss-list">
        {k.sss.map((q) => (
          <details class="sss-item">
            <summary>{q.s}</summary>
            <p>{q.c}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .ka-head { max-width: 980px; }

  .hd-tldr {
    margin-top: var(--space-8);
    padding: var(--space-6) var(--space-7);
    background: var(--color-bg-soft);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }
  .hd-tldr-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-deep);
    margin-bottom: var(--space-3);
  }
  .hd-tldr p {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text);
  }

  .ka-tablo-kapsayici {
    margin-top: var(--space-12);
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .ka-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 720px;
  }
  .ka-tablo th,
  .ka-tablo td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .ka-tablo thead {
    background: var(--color-bg);
  }
  .ka-tablo th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary-deep);
    border-bottom: 2px solid var(--color-primary);
  }
  .ka-tablo tbody tr:hover { background: var(--color-bg-soft); }
  .ka-tablo-ozellik {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    background: var(--color-bg);
  }

  .ka-senaryo-list {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .ka-senaryo {
    padding: var(--space-6);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius-md);
  }
  .ka-senaryo-baslik {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }
  .ka-senaryo-metin {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }

  .ka-bns-blok { max-width: 720px; }
  .ka-bns-metin {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .ka-bns-blok .hero-actions { margin-top: var(--space-7); }
</style>
