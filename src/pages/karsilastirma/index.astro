---
import Layout from "../../layouts/Layout.astro";
import { karsilastirmalar } from "../../data/karsilastirma";

const sayfaURL = "https://bnsenerjidogalgaz.com/karsilastirma/";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": sayfaURL + "#karsilastirma-listesi",
  name: "Marka Karşılaştırma Rehberleri — BNS Enerji & Doğalgaz",
  description: "Kombi, klima ve ısı pompası markalarının üretici teknik dokümanlarına göre nötr karşılaştırması.",
  numberOfItems: karsilastirmalar.length,
  itemListElement: karsilastirmalar.map((k, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Article",
      "@id": `${sayfaURL}${k.slug}/#article`,
      name: k.kisaBaslik,
      url: `https://bnsenerjidogalgaz.com/karsilastirma/${k.slug}/`,
      headline: k.baslik,
      description: k.tldr,
    },
  })),
};
---

<Layout
  title="Marka Karşılaştırma Rehberleri — BNS Enerji & Doğalgaz"
  description="Kombi, klima ve ısı pompası markalarının üretici teknik dokümantasyonuna göre tarafsız teknik karşılaştırma rehberleri."
  extraSchemas={[itemListSchema]}
  breadcrumbs={[
    { name: "Anasayfa", href: "/" },
    { name: "Karşılaştırma", href: "/karsilastirma/" },
  ]}
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Marka Rehberleri</p>
        <h1 class="page-title">Marka karşılaştırma rehberleri</h1>
        <p class="page-intro">
          Kombi, klima ve ısı pompası markalarını üretici teknik dokümantasyonuna
          göre <strong>tarafsız</strong> karşılaştırıyoruz. BNS Enerji & Doğalgaz
          tek marka münhasır temsilcisi değildir; müşterinin isteğine ve
          bütçesine uygun markada cihaz tedarik eder.
        </p>
      </header>

      <div class="ka-hub-grid">
        {karsilastirmalar.map((k) => (
          <a class="ka-hub-kart" href={`/karsilastirma/${k.slug}/`}>
            <span class="ka-hub-eyebrow">{k.kicker}</span>
            <h2 class="ka-hub-baslik">{k.kisaBaslik}</h2>
            <p class="ka-hub-tldr">{k.tldr}</p>
            <p class="ka-hub-markalar">
              {k.markalar.map((m, i) => (
                <span class="ka-hub-marka-pill">{m}</span>
              ))}
            </p>
            <span class="ka-hub-ok">Rehberi oku →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .ka-hub-grid {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  .ka-hub-kart {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    transition:
      border-left-color var(--duration-base) var(--ease-bns),
      box-shadow var(--duration-base) var(--ease-bns),
      transform var(--duration-base) var(--ease-bns);
  }
  .ka-hub-kart:hover {
    border-left-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .ka-hub-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-deep);
  }
  .ka-hub-baslik {
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }
  .ka-hub-tldr {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .ka-hub-markalar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .ka-hub-marka-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 3px 9px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }
  .ka-hub-ok {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }
</style>
