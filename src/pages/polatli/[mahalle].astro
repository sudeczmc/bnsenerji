---
import Layout from "../../layouts/Layout.astro";
import { mahalleler } from "../../data/mahalleler";

export async function getStaticPaths() {
  return mahalleler.map((m) => ({
    params: { mahalle: m.slug },
    props: { mahalle: m },
  }));
}

const { mahalle } = Astro.props;
const sayfaURL = `https://bnsenerjidogalgaz.com/polatli/${mahalle.slug}/`;

const hizmetKart = [
  {
    ad: "Doğalgaz Tesisatı",
    metin: "TS 7363 standardı ve Polgaz onaylı iç tesisat — borulama, vana, sızdırmazlık testi ve gaz açma.",
    href: "/hizmetler/dogalgaz-tesisati/",
  },
  {
    ad: "Kombi Satışı ve Montajı",
    metin: "İsteğinize uygun markada yoğuşmalı kombi tedariki, doğalgaz tesisatı ve sızdırmazlık testi tek elden.",
    href: "/hizmetler/kombi/",
  },
  {
    ad: "Klima Sistemleri",
    metin: "Split, multisplit ve VRF klima tedariki; montaj üreticinin yetkili servisi tarafından.",
    href: "/hizmetler/klima/",
  },
  {
    ad: "Isı Pompası",
    metin: "Hava-su ısı pompası — COP 3-4 verimle ısıtma + soğutma + sıcak su tek sistemde.",
    href: "/hizmetler/isi-pompasi/",
  },
  {
    ad: "Yerden Isıtma",
    metin: "35-45°C düşük su sıcaklığında çalışan, yoğuşmalı kombi ve ısı pompasıyla en verimli sistem.",
    href: "/hizmetler/yerden-isitma/",
  },
  {
    ad: "Kombi Değişimi",
    metin: "Eski kombiyi söker, yoğuşmalı kombiye geçiş yapar, sızdırmazlık testi ve gaz açma süreci tek elden.",
    href: "/hizmetler/kombi-degisimi/",
  },
];

/* ── SCHEMA: Place (mahalle) + Service-areaServed çakışması ── */
const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "@id": sayfaURL + "#place",
  name: `${mahalle.ad}, Polatlı, Ankara`,
  containedInPlace: {
    "@type": "AdministrativeArea",
    name: "Polatlı",
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: "Ankara",
      containedInPlace: { "@type": "Country", name: "Türkiye" },
    },
  },
};

/* ── SCHEMA: Service her hizmet için ── */
const serviceSchemas = hizmetKart.map((h, i) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": sayfaURL + `#service-${i + 1}`,
  name: `${h.ad} — ${mahalle.ad}, Polatlı`,
  description: h.metin,
  provider: { "@id": "https://bnsenerjidogalgaz.com/#business" },
  areaServed: { "@id": sayfaURL + "#place" },
  serviceType: h.ad,
}));

/* ── SCHEMA: FAQPage — mahalle bazlı sorular ── */
const sss = [
  {
    s: `${mahalle.ad}'nde doğalgaz tesisatı yapıyor musunuz?`,
    c: `Evet — ${mahalle.ad} Polatlı dağıtım otoritesi Polgaz hizmet alanındadır. BNS Enerji & Doğalgaz Polgaz Sertifikalı (PG-1065) iç tesisat firmasıdır; iç tesisat projesi, borulama, sızdırmazlık testi ve gaz açma sürecini tek elden yürütür.`,
  },
  {
    s: `${mahalle.ad}'nde kombi değişimi yapıyor musunuz?`,
    c: `Evet — eski kombiyi söküyor, müşteriyle birlikte yeni yoğuşmalı kombiyi seçiyor, gerekirse baca ve doğalgaz tesisatını uyarlıyor, sızdırmazlık testini yapıyoruz. Polgaz teyit testinden sonra gaz açma belgesi alınır.`,
  },
  {
    s: `${mahalle.ad}'nde klima montajı yapıyor musunuz?`,
    c: `Klima satışını BNS Enerji yapar; montaj üreticinin yetkili servisi tarafından gerçekleştirilir. Tek muhatap BNS Enerji, üretici garantisi tam.`,
  },
  {
    s: `${mahalle.ad}'ne keşif için ne zaman gelirsiniz?`,
    c: `Keşif ücretsizdir ve genellikle 1-2 iş günü içinde randevu verilir. Mayıs–Eylül klima sezonunda talep yoğunluğu artar; erken iletişim önerilir. Telefon veya WhatsApp ile +90 532 499 39 86.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": sayfaURL + "#faq",
  mainEntity: sss.map((q) => ({
    "@type": "Question",
    name: q.s,
    acceptedAnswer: { "@type": "Answer", text: q.c },
  })),
};

const title = `Polatlı ${mahalle.ad} Doğalgaz, Kombi ve Klima — BNS Enerji`;
const description = `Polatlı ${mahalle.ad}'nde Polgaz Sertifikalı (PG-1065) doğalgaz tesisatı, kombi montajı, klima ve ısı pompası. ${mahalle.referans ?? "Keşif ücretsiz."}`;
---

<Layout
  title={title}
  description={description}
  extraSchemas={[placeSchema, ...serviceSchemas, faqSchema]}
  mainEntityId={sayfaURL + "#place"}
  breadcrumbs={[
    { name: "Anasayfa", href: "/" },
    { name: "Polatlı", href: "/polatli/" },
    { name: mahalle.ad, href: `/polatli/${mahalle.slug}/` },
  ]}
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head mh-head">
        <p class="eyebrow">{mahalle.konum}</p>
        <h1 class="page-title">Polatlı {mahalle.ad} — Doğalgaz, Kombi ve Klima</h1>
        <p class="page-intro">{mahalle.giris}</p>
        {mahalle.not && <p class="mh-not">{mahalle.not}</p>}
      </header>

      <div class="hero-actions mh-cta">
        <a class="btn btn-fill" href="/iletisim/#kesif-formu">Ücretsiz keşif talebi</a>
        <a class="btn btn-soft" href="tel:+905324993986">0 532 499 39 86</a>
      </div>
    </div>
  </section>

  {/* HİZMETLER */}
  <section class="bolum bolum-soft">
    <div class="container">
      <header class="bolum-head">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>{mahalle.ad}'nde Verilen Hizmetler</p>
        <h2 class="bolum-title">{mahalle.ad}'nde tek elden çözüm</h2>
      </header>
      <div class="kart-grid g-3">
        {hizmetKart.map((h) => (
          <a class="kart kart-link" href={h.href}>
            <h3 class="kart-baslik">{h.ad}</h3>
            <p class="kart-metin">{h.metin}</p>
            <span class="kart-ok">Detay →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* MAHALLE BİLGİSİ + ÖZELLİKLER */}
  <section class="bolum bolum-beyaz">
    <div class="container mh-detay-split">
      <div class="mh-detay-metin">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Mahalle ve Altyapı</p>
        <h2 class="bolum-title">{mahalle.ad} — doğalgaz altyapı durumu</h2>
        <p class="mh-altyapi">{mahalle.altyapi}</p>
        {mahalle.referans && (
          <div class="mh-referans">
            <p class="mh-referans-kicker">Bu mahalledeki referans projemiz</p>
            <p class="mh-referans-metin"><strong>{mahalle.referans}</strong></p>
          </div>
        )}
      </div>
      <ul class="mh-ozellik-liste">
        {mahalle.ozellik.map((o) => (
          <li class="mh-ozellik">
            <span class="mh-ozellik-tick" aria-hidden="true">✓</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* YETKİ */}
  <section class="bolum bolum-soft">
    <div class="container yetki-mh">
      <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Yetki &amp; Güven</p>
      <h2 class="bolum-title">Polgaz Sertifikalı (PG-1065)</h2>
      <p class="bolum-aciklama">
        BNS Enerji & Doğalgaz, Polatlı doğalgaz dağıtıcısı Polgaz'ın
        <strong> Sertifikalı Firmalar listesinde PG-1065 sertifika numarası</strong>
        ile yer alır. Tüm iç tesisat projeleri Polgaz onayına sunulur ve
        sızdırmazlık testiyle teslim edilir.
      </p>
      <p class="bolum-aciklama">
        2020'den bu yana <strong>Polatlı Belediye Binası, Ticaret Odası, Şehir
        Stadı ve Öğretmenevi</strong> dahil 14 kurumsal projeyi teslim ettik.
      </p>
      <a class="bolum-link" href="/referanslar/">14 referans projesi →</a>
    </div>
  </section>

  {/* SSS */}
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="bolum-head">
        <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Sık Sorulan Sorular</p>
        <h2 class="bolum-title">{mahalle.ad}'ne özel sorular</h2>
      </header>
      <div class="sss-list">
        {sss.map((q) => (
          <details class="sss-item">
            <summary>{q.s}</summary>
            <p>{q.c}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* KAPANIŞ */}
  <section class="kapanis">
    <div class="container kapanis-grid">
      <div class="kapanis-metin">
        <p class="bolum-kicker kapanis-kicker"><span class="kicker-tick" aria-hidden="true"></span>İletişim</p>
        <h2 class="kapanis-baslik">{mahalle.ad} için keşif randevusu bir telefon kadar yakın</h2>
        <p class="kapanis-adres">
          Fatih Mah., Bıyıktay Cd. 37/A, Polatlı / Ankara · Pzt–Cmt 08:00 – 20:00
        </p>
      </div>
      <div class="kapanis-cta">
        <a class="btn btn-light" href="tel:+905324993986">0 532 499 39 86</a>
        <a class="btn btn-wa" href="https://wa.me/905324993986?text=Merhaba%20BNS%20Enerji%2C%20kesif%20talebim%20var." target="_blank" rel="noopener">WhatsApp'tan yazın</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .mh-head { max-width: 880px; }
  .mh-not {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .mh-cta {
    margin-top: var(--space-8);
  }

  .mh-detay-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .mh-altyapi {
    margin-top: var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-body);
  }
  .mh-referans {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--color-bg-soft);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }
  .mh-referans-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-deep);
    margin-bottom: var(--space-2);
  }
  .mh-referans-metin {
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .mh-ozellik-liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mh-ozellik {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .mh-ozellik-tick {
    color: var(--color-primary);
    font-weight: var(--weight-bold);
    flex-shrink: 0;
  }

  .yetki-mh .bolum-aciklama {
    max-width: 60ch;
    margin-top: var(--space-5);
  }

  @media (max-width: 860px) {
    .mh-detay-split { grid-template-columns: 1fr; }
  }
</style>
