---
import Layout from "../layouts/Layout.astro";

const kartlar = [
  {
    baslik: "Adres",
    deger: "Fatih Mah., Bıyıktay Cd. 37/A, 06900 Polatlı / Ankara",
    href: null,
    icon: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
  },
  {
    baslik: "Telefon",
    deger: "0 (532) 499 39 86",
    href: "tel:+905324993986",
    icon: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  },
  {
    baslik: "E-posta",
    deger: "bnsenerji@gmail.com",
    href: "mailto:bnsenerji@gmail.com",
    icon: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/>`,
  },
  {
    baslik: "Çalışma Saatleri",
    deger: "Pazartesi – Cumartesi, 08:00 – 20:00",
    href: null,
    icon: `<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>`,
  },
  {
    baslik: "Sosyal Medya",
    deger: "Instagram: @bnsenerjidogalgaz",
    href: "https://www.instagram.com/bnsenerjidogalgaz",
    icon: `<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>`,
  },
  {
    baslik: "WhatsApp",
    deger: "Hızlı iletişim için yazın",
    href: "https://wa.me/905324993986",
    icon: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`,
  },
];

const hizmetSecenek = [
  "Doğalgaz Tesisatı",
  "Klima Sistemleri",
  "Isı Pompası",
  "Yangın Söndürme Sistemleri",
  "Yerden Isıtma",
  "Merkezi Isıtma & Kazan",
  "Diğer / Emin değilim",
];

const web3key = import.meta.env.PUBLIC_WEB3FORMS_KEY || "";
---

<Layout
  title="İletişim — Polatlı Doğalgaz ve Tesisat | BNS Enerji"
  description="Polatlı doğalgaz ve tesisat için BNS Enerji & Doğalgaz: keşif talebi formu, Fatih Mah., Bıyıktay Cd. 37/A, Polatlı / Ankara. Telefon 0 532 499 39 86."
>
  <section class="bolum bolum-beyaz">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">İletişim</p>
        <h1 class="page-title">Bizimle iletişime geçin</h1>
        <p class="page-intro">
          Doğrudan ulaşın ya da keşif talebi oluşturun — uzman ekibimiz
          projeleriniz için yanınızda.
        </p>
      </header>

      <!-- ─── İLETİŞİM BİLGİLERİ ─── -->
      <div class="kart-grid g-3">
        {kartlar.map((k) => (
          <div class="kart">
            <span class="kart-ikon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" set:html={k.icon} />
            </span>
            <h2 class="kart-baslik kart-baslik-sm">{k.baslik}</h2>
            {k.href ? (
              <a class="kart-metin il-deger" href={k.href} target={k.href.startsWith("http") ? "_blank" : null} rel={k.href.startsWith("http") ? "noopener" : null}>{k.deger}</a>
            ) : (
              <p class="kart-metin">{k.deger}</p>
            )}
          </div>
        ))}
      </div>

      <iframe
        class="il-harita"
        src="https://www.google.com/maps?q=Fatih,+Bıyıktay+Cd.+37/A,+Polatlı,+Ankara&output=embed"
        width="100%"
        height="360"
        loading="lazy"
        title="BNS Enerji & Doğalgaz konum haritası"
      ></iframe>

      <!-- ─── KEŞİF TALEBİ FORMU ─── -->
      <div class="kesif-blok" id="kesif-formu">
        <div class="kesif-head">
          <p class="bolum-kicker"><span class="kicker-tick" aria-hidden="true"></span>Keşif Talebi</p>
          <h2 class="kesif-baslik">Ücretsiz keşif talebi oluşturun</h2>
          <p class="kesif-aciklama">
            Formu doldurun; ekibimiz en kısa sürede sizinle iletişime geçip
            yerinde keşif için randevu oluştursun.
          </p>
        </div>

        <form class="kesif-form" id="kesifForm">
          <input type="hidden" name="access_key" value={web3key} />
          <input type="hidden" name="subject" value="BNS Enerji — Yeni Keşif Talebi" />
          <input type="hidden" name="from_name" value="BNS Enerji Web Sitesi" />
          <input type="checkbox" name="botcheck" class="bot-alan" tabindex="-1" autocomplete="off" />

          <div class="form-satir">
            <label class="form-alan">
              <span>Ad Soyad</span>
              <input type="text" name="Ad Soyad" required autocomplete="name" />
            </label>
            <label class="form-alan">
              <span>Telefon</span>
              <input type="tel" name="Telefon" required autocomplete="tel" placeholder="0 5__ ___ __ __" />
            </label>
          </div>

          <label class="form-alan">
            <span>E-posta <em>(opsiyonel)</em></span>
            <input type="email" name="E-posta" autocomplete="email" />
          </label>

          <label class="form-alan">
            <span>İlgilendiğiniz hizmet</span>
            <select name="Hizmet">
              {hizmetSecenek.map((h) => <option value={h}>{h}</option>)}
            </select>
          </label>

          <label class="form-alan">
            <span>Talebiniz</span>
            <textarea name="Mesaj" rows="4" placeholder="Adres, ihtiyaç ve sizin için uygun zamanı kısaca yazabilirsiniz."></textarea>
          </label>

          <button type="submit" class="btn btn-fill kesif-gonder">Keşif talebi gönder</button>
          <p class="form-durum" id="formDurum" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById("kesifForm");
  const durum = document.getElementById("formDurum");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]");
      durum.className = "form-durum";
      durum.textContent = "Gönderiliyor…";
      btn.disabled = true;
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });
        const json = await res.json();
        if (json.success) {
          durum.className = "form-durum basarili";
          durum.textContent = "Talebiniz alındı — en kısa sürede sizi arayacağız.";
          form.reset();
        } else {
          durum.className = "form-durum hata";
          durum.textContent = "Gönderilemedi. Lütfen telefonla ulaşın: 0 532 499 39 86";
        }
      } catch {
        durum.className = "form-durum hata";
        durum.textContent = "Bağlantı hatası. Lütfen telefonla ulaşın: 0 532 499 39 86";
      }
      btn.disabled = false;
    });
  }
</script>

<style is:global>
  /* ═══ KEŞİF FORMU ═══ */
  .kesif-blok {
    margin-top: var(--space-12);
    scroll-margin-top: 110px;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  .kesif-baslik {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    color: var(--color-text);
  }
  .kesif-aciklama {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }

  .kesif-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .form-satir {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .form-alan {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .form-alan > span {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }
  .form-alan > span em {
    font-style: normal;
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }
  .form-alan input,
  .form-alan select,
  .form-alan textarea {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.85rem;
    transition: border-color var(--duration-base) var(--ease-bns);
  }
  .form-alan textarea { resize: vertical; }
  .form-alan input:focus,
  .form-alan select:focus,
  .form-alan textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .bot-alan {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .kesif-gonder { margin-top: var(--space-2); align-self: flex-start; }
  .form-durum {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    min-height: 1.2em;
  }
  .form-durum.basarili { color: var(--color-primary-deep); }
  .form-durum.hata { color: var(--color-danger); }

  @media (max-width: 760px) {
    .kesif-blok { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 480px) {
    .form-satir { grid-template-columns: 1fr; }
  }

  /* ═══ İLETİŞİM KARTLARI + HARİTA ═══ */
  .il-deger { font-weight: var(--weight-medium); color: var(--color-text); }
  a.il-deger:hover { color: var(--color-primary); }
  .il-harita {
    width: 100%;
    border: 0;
    border-radius: var(--radius-lg);
    margin-top: var(--space-12);
    display: block;
  }
</style>
